---
const LEAD_ENDPOINT = import.meta.env.PUBLIC_LEAD_ENDPOINT || "https://admin.deleadint.com/api/lead";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DLI Professionals: Future Skills: De' Lead International</title>
<meta name="description" content="DLI Professionals delivers future-skills and soft-skills training from De' Lead International: design thinking, leadership, communication, entrepreneurship, and applied Gen AI for educators and HR teams.">
<link rel="icon" href="/assets/logo/logo-delead-dark.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true">
  <symbol id="i-rocket" viewBox="0 0 24 24"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2zM9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></symbol>
  <symbol id="i-code" viewBox="0 0 24 24"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></symbol>
  <symbol id="i-sparkles" viewBox="0 0 24 24"><path d="M12 3l1.9 5.6L19.5 10l-5.6 1.4L12 17l-1.9-5.6L4.5 10l5.6-1.4zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></symbol>
  <symbol id="i-palette" viewBox="0 0 24 24"><path d="M12 22a10 10 0 1 1 0-20c5.5 0 10 3.6 10 8a4 4 0 0 1-4 4h-2.3c-1.1 0-2 .9-2 1.9 0 .4.2.8.5 1.2.3.3.5.8.5 1.3 0 1.1-.9 2-2 2z"/><circle cx="7.5" cy="10.5" r="1.1"/><circle cx="12" cy="7.5" r="1.1"/><circle cx="16.5" cy="10.5" r="1.1"/></symbol>
  <symbol id="i-bot" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M12 7v4M12 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM8 16h.01M16 16h.01M2 14v2M22 14v2"/></symbol>
  <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></symbol>
  <symbol id="i-box" viewBox="0 0 24 24"><path d="M12 3l9 5v8l-9 5-9-5V8zM12 12l9-5M12 12v10M12 12L3 7"/></symbol>
  <symbol id="i-chart" viewBox="0 0 24 24"><path d="M3 3v18h18M7 15l3-4 3 2 5-7"/></symbol>
  <symbol id="i-wifi" viewBox="0 0 24 24"><path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a6 6 0 0 1 7 0M2 9a15 15 0 0 1 20 0M12 20h.01"/></symbol>
  <symbol id="i-graduation" viewBox="0 0 24 24"><path d="M22 10L12 5 2 10l10 5 10-5zM6 12v5c0 1 2.7 3 6 3s6-2 6-3v-5M20 11v6"/></symbol>
  <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></symbol>
  <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
  <symbol id="i-monitor" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></symbol>
  <symbol id="i-building" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4M9 6h.01M15 6h.01M9 10h.01M15 10h.01M9 14h.01M15 14h.01"/></symbol>
  <symbol id="i-tent" viewBox="0 0 24 24"><path d="M3.5 21 14 4M20.5 21 10 4M12 13.5 8.5 21M2 21h20"/></symbol>
  <symbol id="i-briefcase" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></symbol>
  <symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4"/></symbol>
  <symbol id="i-message" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/></symbol>
  <symbol id="i-lightbulb" viewBox="0 0 24 24"><path d="M9 18h6M10 22h4M15 14c.2-1 .7-1.7 1.4-2.5A4.7 4.7 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.8.8 1.3 1.5 1.5 2.5"/></symbol>
  <symbol id="i-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M16.2 7.8l-2.1 6.3-6.3 2.1 2.1-6.3z"/></symbol>
  <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></symbol>
  <symbol id="i-layers" viewBox="0 0 24 24"><path d="M12 2l9 5-9 5-9-5zM3 12l9 5 9-5M3 17l9 5 9-5"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></symbol>
</svg>

<!-- ============ NAV ============ -->
<header class="nav">
  <div class="nav-inner">
    <a href="/" class="brand">
      <img src="/assets/logo/logo-delead-dark.png" alt="De' Lead International">
      <span>DLI Professionals</span>
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="#areas">Skill areas</a>
      <a href="#gen-ai">Gen AI tracks</a>
      <a href="#who">Who it's for</a>
      <a href="/students">Students</a>
      <a href="#contact">Contact</a>
      <a class="nav-back" href="/">&larr; DLI Education</a>
    </nav>
    <div class="nav-cta">
      <a class="btn btn-magenta nav-desk" href="/">&larr; DLI Education</a>
      <a class="btn btn-dark" href="#contact">Enquire</a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero-panel">
    <h1 class="h1">Skills that shape<br>leaders.</h1>
    <p class="hero-sub">Academic knowledge alone is no longer enough. Future-skills and soft-skills training for educators, HR teams, institutions and working professionals, plus applied Gen AI.</p>
    <div class="hero-paths">
      <a class="hp-pros" href="#areas">See the skill areas
        <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      <a class="hp-students" href="/students">For students
        <svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>

    <div class="hero-cols">
      <div class="hero-intro">
        <h3><svg class="ic" aria-hidden="true"><use href="#i-lightbulb"/></svg> The gap is not knowledge</h3>
        <p>It is what you do with it. We build the cognitive and interpersonal skills that complex, fast-changing work asks for.</p>
        <div class="avatars"><span>DT</span><span>LD</span><span>AI</span><span>HR</span><span>+</span></div>
        <div class="hi-count">6 skill areas, plus applied Gen AI</div>
      </div>

      <figure class="hero-figure">
        <svg class="squiggle" viewBox="0 0 220 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M14 224c-4-48 26-84 70-84 40 0 58 44 22 66-30 18-70-8-46-44 20-30 74-40 128-96" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
        </svg>
        <img src="/assets/photos/session-1.webp" alt="A DLI Education professional training session">
        <span class="photo-tag pt-1">Hands-on</span>
        <span class="photo-tag pt-2">Cohort or 1-to-1</span>
      </figure>

      <div class="hero-aside">
        <div class="hero-blobs"><i></i><i></i><i></i></div>
        <p>Delivered the same hands-on way as the rest of De' Lead International, scoped to your team, department or whole institution.</p>
        <a href="#areas" class="btn">See the skill areas
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg></a>
      </div>
    </div>
  </div>
</section>

<!-- ============ WHY ============ -->
<section class="section">
  <div class="wrap">
    <article class="tcard lav reveal" style="padding:34px">
      <span class="kicker">Why future skills</span>
      <h2 class="h2" style="margin-top:8px">The gap is not knowledge, it is what you do with it</h2>
      <p>Students and professionals need strong cognitive and interpersonal skills to navigate complex, fast-changing challenges. DLI Professionals builds those through structured programmes for schools, colleges, institutions and working teams, delivered the same hands-on way as the rest of De' Lead International.</p>
    </article>
  </div>
</section>

<!-- ============ SKILL AREAS ============ -->
<section class="section" id="areas">
  <div class="wrap">
    <div class="shead simple reveal">
      <h2 class="h2">Six skill areas</h2>
      <p class="sh-note">Delivered on their own or combined into a programme for a team, a department or a whole institution.</p>
    </div>
    <div class="tgrid c3">
      <article class="tcard teal reveal"><span class="tc-ico"><svg class="ic"><use href="#i-lightbulb"/></svg></span><h3>Design Thinking</h3><p>A repeatable way to frame the right problem and prototype solutions with real users in mind.</p></article>
      <article class="tcard lav reveal"><span class="tc-ico"><svg class="ic"><use href="#i-target"/></svg></span><h3>Leadership Development</h3><p>Decision-making, delegation and leading through change, for people who have to carry a room.</p></article>
      <article class="tcard peach reveal"><span class="tc-ico"><svg class="ic"><use href="#i-message"/></svg></span><h3>Communication Skills</h3><p>Clear writing, confident speaking and the everyday conversations that move work forward.</p></article>
      <article class="tcard rose reveal"><span class="tc-ico"><svg class="ic"><use href="#i-rocket"/></svg></span><h3>Entrepreneurship Mindset</h3><p>Spotting opportunity, testing ideas cheaply and moving from a concept to a pitch.</p></article>
      <article class="tcard lime reveal"><span class="tc-ico"><svg class="ic"><use href="#i-compass"/></svg></span><h3>Critical Thinking</h3><p>Structured reasoning, questioning assumptions and weighing evidence under pressure.</p></article>
      <article class="tcard teal reveal"><span class="tc-ico"><svg class="ic"><use href="#i-grid"/></svg></span><h3>Innovation &amp; Problem Solving</h3><p>Turning critical thinking into practice: generating options and choosing well.</p></article>
    </div>
  </div>
</section>

<!-- ============ GEN AI TRACKS ============ -->
<section class="section" id="gen-ai">
  <div class="wrap">
    <div class="shead reveal">
      <div><span class="kicker">Applied Gen AI</span><h2 class="h2" style="margin-top:10px">Gen AI, for the work you already do</h2></div>
      <div class="deco" aria-hidden="true"><svg class="ic"><use href="#i-sparkles"/></svg></div>
      <p class="sh-note">AI is not always about replacing everything, often it is about improving what a team already has. Two tracks, each two months.</p>
    </div>

    <article class="proc reveal">
      <h3>Gen AI for Educators</h3>
      <p class="pc-sub">2 months &middot; group or 1-to-1</p>
      <ul>
        <li>AI-powered teaching techniques</li>
        <li>Content creation: lesson plans, projects, assignments</li>
        <li>Daily operations and admin</li>
        <li>Presentations and media</li>
        <li>Assessment tools</li>
        <li>Innovation and classroom ethics</li>
      </ul>
      <p class="pc-meta">For teachers, heads of department and teacher-training institutions.</p>
    </article>

    <article class="proc reveal">
      <h3>Gen AI for HR</h3>
      <p class="pc-sub">2 months &middot; 1-to-1 available</p>
      <ul>
        <li>Revolutionising HR operations with AI</li>
        <li>Reporting and analytics</li>
        <li>Talent acquisition and performance management</li>
        <li>Training and development</li>
        <li>Proposals and presentations</li>
        <li>Ethical AI usage</li>
      </ul>
      <p class="pc-meta">For HR generalists, L&amp;D leads and people teams.</p>
    </article>
  </div>
</section>

<!-- ============ WHO IT'S FOR ============ -->
<section class="section" id="who">
  <div class="wrap">
    <div class="shead simple reveal">
      <h2 class="h2">Built for institutions and teams</h2>
      <p class="sh-note">Programmes are scoped to the group and run on site, online or as a workshop series.</p>
    </div>
    <div class="tgrid c2">
      <article class="tcard teal reveal"><span class="tc-ico"><svg class="ic"><use href="#i-building"/></svg></span><h3>Schools</h3><p>Future-skills and Gen AI training for teaching staff, alongside academic learning.</p></article>
      <article class="tcard lav reveal"><span class="tc-ico"><svg class="ic"><use href="#i-graduation"/></svg></span><h3>Colleges</h3><p>Employability and leadership programmes for students close to the workforce.</p></article>
      <article class="tcard peach reveal"><span class="tc-ico"><svg class="ic"><use href="#i-layers"/></svg></span><h3>Institutions</h3><p>Structured cohorts for government and non-profit teams.</p></article>
      <article class="tcard rose reveal"><span class="tc-ico"><svg class="ic"><use href="#i-briefcase"/></svg></span><h3>Working professionals</h3><p>Individuals upgrading cognitive and interpersonal skills, group or 1-to-1.</p></article>
    </div>
  </div>
</section>

<!-- ============ FORMATS ============ -->
<section class="section">
  <div class="wrap">
    <div class="shead simple reveal">
      <h2 class="h2">Four formats</h2>
    </div>
    <div class="tgrid c2">
      <article class="tcard lime reveal"><span class="tc-ico"><svg class="ic"><use href="#i-users"/></svg></span><h3>Cohort programme</h3><p>A fixed group moving through a syllabus together over several weeks.</p></article>
      <article class="tcard lav reveal"><span class="tc-ico"><svg class="ic"><use href="#i-message"/></svg></span><h3>1-to-1 coaching</h3><p>An individual track for a professional or a leader, paced to their schedule.</p></article>
      <article class="tcard peach reveal"><span class="tc-ico"><svg class="ic"><use href="#i-briefcase"/></svg></span><h3>Corporate workshop</h3><p>A focused one or two-day session for a company team.</p></article>
      <article class="tcard teal reveal"><span class="tc-ico"><svg class="ic"><use href="#i-building"/></svg></span><h3>Institutional programme</h3><p>A multi-cohort rollout across a school, college or department.</p></article>
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section">
  <div class="wrap">
    <div class="shead simple reveal">
      <span class="kicker">In their words</span>
      <h2 class="h2" style="margin-top:10px">From the people in the room</h2>
    </div>
    <div class="qgrid reveal">
      <figure class="qcard"><span class="q-m" aria-hidden="true">&ldquo;</span><blockquote>[Placeholder. Send an approved quote from an educator or HR lead who took a DLI Professionals programme, with a name and a role.]</blockquote><figcaption><b>[Name]</b><span>[Role, organisation]</span></figcaption></figure>
      <figure class="qcard"><span class="q-m" aria-hidden="true">&ldquo;</span><blockquote>[Placeholder.]</blockquote><figcaption><b>[Name]</b><span>[Role, organisation]</span></figcaption></figure>
      <figure class="qcard"><span class="q-m" aria-hidden="true">&ldquo;</span><blockquote>[Placeholder.]</blockquote><figcaption><b>[Name]</b><span>[Role, organisation]</span></figcaption></figure>
    </div>
    <p class="qnote">All three quotes are placeholders. Send approved wording, names and roles and we will replace them.</p>
  </div>
</section>

<!-- ============ CTA BAND ============ -->
<section class="ctaband">
  <div class="ctaband-inner reveal">
    <span class="cb-ico cb-1" aria-hidden="true"><svg class="ic"><use href="#i-graduation"/></svg></span>
    <span class="cb-ico cb-2" aria-hidden="true"><svg class="ic"><use href="#i-book"/></svg></span>
    <h2 class="h2">Design a programme</h2>
    <p>Tell us the team, the skills you want to build and the time you have. We will scope a cohort or a workshop around it.</p>
    <a href="#contact" class="btn">Start your enquiry
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg></a>
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section class="section" id="contact">
  <div class="contact-inner">
    <div class="shead simple reveal">
      <span class="kicker">Get in touch</span>
      <h2 class="h2" style="margin-top:10px">Start a conversation</h2>
      <p class="sh-note">We reply within a couple of working days.</p>
    </div>
    <div class="contact-grid">
      <div class="contact-card reveal">
        <h3 class="h3">Talk to us</h3>
        <ul class="c-lines">
          <li><a href="mailto:info@deleadint.com">info@deleadint.com</a></li>
          <li><a href="tel:+918075566081">+91 807 556 6081</a>, India</li>
          <li><a href="tel:+971506814538">+971 50 681 4538</a>, UAE</li>
        </ul>
      </div>
      <form data-lead-source="dli_education" class="contact-card cf reveal" id="enquiryForm" novalidate>
        <div class="cf-row">
          <div class="cf-field"><label for="f-name">Name</label><input type="text" id="f-name" name="name" required></div>
          <div class="cf-field"><label for="f-email">Work email</label><input type="email" id="f-email" name="email" required></div>
        </div>
        <div class="cf-row">
          <div class="cf-field"><label for="f-org">Organisation</label><input type="text" id="f-org" name="organisation"></div>
          <div class="cf-field"><label for="f-interest">Interested in</label>
            <select id="f-interest" name="interest">
              <option>Design Thinking</option>
              <option>Leadership Development</option>
              <option>Communication Skills</option>
              <option>Entrepreneurship Mindset</option>
              <option>Critical Thinking &amp; Problem Solving</option>
              <option>Gen AI for Educators</option>
              <option>Gen AI for HR</option>
              <option>A combined institutional programme</option>
              <option>Not sure yet</option>
            </select>
          </div>
        </div>
        <div class="cf-field full"><label for="f-message">Message</label><textarea id="f-message" name="message" rows="4" required></textarea></div>
        <button type="submit" class="btn">Send message</button>
        <p class="form-success" id="formSuccess" hidden>Thanks, your message is in. We will be in touch within a couple of working days.</p>
      </form>
    </div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
