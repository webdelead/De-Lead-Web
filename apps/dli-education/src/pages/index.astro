---
import Base from "../layouts/Base.astro";
import SiteHeader from "@delead/ui/astro/SiteHeader.astro";
import SiteFooter from "@delead/ui/astro/SiteFooter.astro";
import LeadForm from "@delead/ui/astro/LeadForm.astro";
import Stat from "@delead/ui/astro/Stat.astro";
import { getContent } from "../lib/content";

const { coursesStudents, outcomes, testimonials, stats } = await getContent();
const featured = coursesStudents.filter((c) => c.isFeatured).slice(0, 6);

const navLinks = [
  { label: "Students", href: "/students" },
  { label: "Professionals", href: "/professionals" },
  { label: "Outcomes", href: "#outcomes" },
  { label: "Contact", href: "#contact" },
];
---
<Base
  title="DLI Education — De' Lead International"
  description="The technology and future-skills learning arm of De' Lead International. Hands-on, mentor-led programmes for students and working professionals across India and the UAE."
>
  <SiteHeader
    current="dli-education"
    brandHref="/"
    logoLight="/assets/logo/logo-delead-white.png"
    logoDark="/assets/logo/logo-delead-dark.png"
    links={navLinks}
    ctaLabel="Enquire"
    ctaHref="#contact"
  />

  <section id="top" class="relative flex min-h-[84svh] flex-col justify-center overflow-hidden bg-[linear-gradient(160deg,#142653,#0a1533)] px-6 pb-16 pt-32 text-white">
    <div class="mx-auto w-full max-w-[1240px]">
      <p class="mb-5 text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-dli-teal)]">#anyonecancode</p>
      <h1 class="max-w-[16ch] font-[var(--font-rounded)] text-[clamp(2.8rem,7vw,5.4rem)] font-extrabold leading-[1.02]">
        Build real skills. Have real fun.
      </h1>
      <p class="mt-6 max-w-[54ch] text-lg text-white/80">
        Mentor-led courses in coding, AI and robotics for students, plus future-skills training
        for working professionals. Online, offline, camps and workshops.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/students" class="ui-btn ui-btn--primary" style="--accent:var(--color-dli-teal);--accent-ink:#06232b">For students</a>
        <a href="/professionals" class="ui-btn ui-btn--ghost">For professionals</a>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-[1240px] grid-cols-2 sm:grid-cols-4">
      {stats.map((s) => (
        <div class="border-l border-[var(--color-line)] px-4 py-7 first:border-l-0 sm:px-8">
          <Stat value={s.value} suffix={s.suffix} label={s.label} />
        </div>
      ))}
    </div>
  </section>

  <section class="bg-[var(--color-cream)] px-6 py-24">
    <div class="mx-auto max-w-[1240px]">
      <div class="max-w-[640px]" data-reveal>
        <span class="ui-eyebrow">Two paths, one method</span>
        <h2 class="mt-3 font-[var(--font-rounded)] text-[clamp(2rem,4vw,3rem)] font-extrabold">Pick the track that fits</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2" data-reveal="stagger">
        <a href="/students" class="rounded-2xl border border-[var(--color-line)] bg-white p-8 transition-transform hover:-translate-y-1">
          <span class="rounded-full bg-[var(--color-dli-teal)]/15 px-3 py-1 text-xs font-bold text-[var(--color-dli-teal)]">For students</span>
          <h3 class="mt-3 font-[var(--font-rounded)] text-2xl font-bold">Technology courses, ages 7 to college</h3>
          <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Python, web, robotics, 3D design, data, Gen AI and block coding. Real projects, a mentor per learner, a certificate at the end.</p>
          <span class="mt-4 inline-block text-sm font-semibold text-[var(--color-dli-teal)]">Explore student courses →</span>
        </a>
        <a href="/professionals" class="rounded-2xl border border-[var(--color-line)] bg-white p-8 transition-transform hover:-translate-y-1">
          <span class="rounded-full bg-[var(--color-dli-navy)]/10 px-3 py-1 text-xs font-bold text-[var(--color-dli-navy)]">For professionals</span>
          <h3 class="mt-3 font-[var(--font-rounded)] text-2xl font-bold">Future skills for educators, HR and teams</h3>
          <p class="mt-2 text-sm text-[var(--color-ink-soft)]">Design thinking, leadership, communication, an entrepreneurial mindset and applied Gen AI for the way your team actually works.</p>
          <span class="mt-4 inline-block text-sm font-semibold text-[var(--color-dli-navy)]">Explore professional tracks →</span>
        </a>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-[1240px]">
        <div class="flex items-end justify-between" data-reveal>
          <h2 class="font-[var(--font-rounded)] text-[clamp(1.9rem,3.4vw,2.8rem)] font-extrabold">Featured tracks</h2>
          <a href="/students#catalogue" class="text-sm font-semibold text-[var(--color-dli-teal)]">See all courses →</a>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
          {featured.map((c) => (
            <article class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-cream)] p-6">
              <span class="text-xs font-bold uppercase tracking-wide text-[var(--color-dli-teal)]">{c.track}</span>
              <h3 class="mt-1 font-[var(--font-rounded)] text-lg font-bold">{c.title}</h3>
              <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{c.description}</p>
              <p class="mt-3 text-xs text-[var(--color-ink-soft)]">{c.ageLabel} · {c.durationLabel}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {outcomes.length > 0 && (
    <section id="outcomes" class="bg-[var(--color-cream-2)] px-6 py-24">
      <div class="mx-auto max-w-[1240px]">
        <h2 class="max-w-[640px] font-[var(--font-rounded)] text-[clamp(1.9rem,3.4vw,2.8rem)] font-extrabold" data-reveal>What learners go on to do</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3" data-reveal="stagger">
          {outcomes.map((o) => (
            <figure class="rounded-2xl bg-white p-7">
              <div class="font-[var(--font-rounded)] font-bold">{o.name}</div>
              <div class="text-xs text-[var(--color-ink-soft)]">{o.place}</div>
              <p class="mt-3 text-sm text-[var(--color-ink-soft)]">{o.win}</p>
              {o.tag && <span class="mt-3 inline-block rounded-full bg-[var(--color-dli-teal)]/15 px-3 py-1 text-xs font-semibold text-[var(--color-dli-teal)]">{o.tag}</span>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="contact" class="bg-white px-6 py-24">
    <div class="mx-auto grid max-w-[1240px] gap-12 lg:grid-cols-2">
      <div data-reveal>
        <span class="ui-eyebrow">Get in touch</span>
        <h2 class="mt-3 font-[var(--font-rounded)] text-[clamp(1.9rem,3.4vw,2.8rem)] font-extrabold">Ready to build something real?</h2>
        <p class="mt-4 max-w-[46ch] text-[var(--color-ink-soft)]">Tell us who's learning, what they want to build, and how you'd like it delivered.</p>
      </div>
      <div data-reveal>
        <LeadForm source="dli_education" interests={["DLI Students — technology courses", "DLI Professionals — future skills", "Gen AI for Educators or HR", "A programme for a school or college", "A corporate workshop", "Not sure yet"]} />
      </div>
    </div>
  </section>

  <SiteFooter brandName="DLI Education" blurb="The technology and future-skills learning arm of De' Lead International — hands-on programmes for students and professionals across India and the UAE." />
</Base>
