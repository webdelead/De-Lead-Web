---
import Base from "../../layouts/Base.astro";
import SiteHeader from "@delead/ui/astro/SiteHeader.astro";
import SiteFooter from "@delead/ui/astro/SiteFooter.astro";
import { marked } from "marked";
import { createDb, blogPosts, assets, eq, and, desc } from "@delead/db";
import { assetUrl } from "@delead/ui/lib";

export async function getStaticPaths() {
  const { db } = createDb(process.env.DATABASE_URL!);
  const rows = await db
    .select()
    .from(blogPosts)
    .where(eq(blogPosts.status, "published"))
    .orderBy(desc(blogPosts.publishedAt));
  const coverIds = rows.map((r) => r.coverAssetId).filter(Boolean) as string[];
  const cover = coverIds.length
    ? new Map((await db.select().from(assets).where(eq(assets.id, coverIds[0]!))).map((a) => [a.id, assetUrl(a)]))
    : new Map();
  return rows.map((p) => ({
    params: { slug: p.slug },
    props: {
      post: p,
      coverUrl: p.coverAssetId ? (cover.get(p.coverAssetId) ?? "") : "",
      html: marked.parse(p.bodyMd || ""),
    },
  }));
}

const { post, coverUrl, html } = Astro.props;
const navLinks = [
  { label: "About", href: "/#about" },
  { label: "Ecosystem", href: "/#ecosystem" },
  { label: "Journal", href: "/#journal" },
  { label: "Contact", href: "/#contact" },
];
---
<Base title={`${post.title} | De' Lead Journal`} description={post.excerpt} path={`/journal/${post.slug}`}>
  <SiteHeader
    current="deleadint"
    brandHref="/"
    logoLight="/assets/logo/logo-delead-white.png"
    logoDark="/assets/logo/logo-delead-dark.png"
    links={navLinks}
    ctaLabel="Partner with us"
    ctaHref="/#contact"
  />
  <article class="mx-auto max-w-[720px] px-6 pb-24 pt-32">
    <a href="/#journal" class="text-sm text-[var(--color-magenta)]">← The Journal</a>
    <span class="mt-6 block text-xs font-bold uppercase tracking-[0.06em] text-[var(--color-magenta)]">
      {post.tag}
    </span>
    <h1 class="mt-2 font-[var(--font-display)] text-[clamp(2rem,4vw,3rem)] font-semibold leading-tight tracking-tight">
      {post.title}
    </h1>
    <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
      {post.authorName}
      {post.publishedAt && ` · ${new Date(post.publishedAt).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })}`}
    </p>
    {coverUrl && <img src={coverUrl} alt="" class="mt-8 w-full rounded-2xl object-cover" />}
    <div
      class="prose mt-10 max-w-none [&_a]:text-[var(--color-magenta)] [&_a]:underline [&_h2]:mt-8 [&_h2]:font-[var(--font-display)] [&_h2]:text-2xl [&_h2]:font-semibold [&_p]:mt-4 [&_p]:leading-relaxed [&_p]:text-[var(--color-ink-soft)] [&_strong]:text-[var(--color-ink)]"
      set:html={html}
    />
  </article>
  <SiteFooter />
</Base>
