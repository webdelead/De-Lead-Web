---
const LEAD_ENDPOINT = import.meta.env.PUBLIC_LEAD_ENDPOINT || "https://admin.deleadint.com/api/lead";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>De' Lead International | Learn, Develop &amp; Lead</title>
<meta name="description" content="De' Lead International is an education innovation ecosystem running Corporate Training, TinkerChamps, MakerChamps, DLI Education, Goal Finder and DLI Foundation (Walk2Lead CSR) across India and the UAE.">
<link rel="icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&family=Host+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,600;0,700;1,600&family=Baloo+2:wght@600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@600;700;800&family=Caveat:wght@400;600;700&family=Covered+By+Your+Grace&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<!-- ============ NAV ============ -->
<header class="nav">
  <div class="container">
    <a href="#top" class="brand">
      <img class="brand-white" src="/assets/logo/logo-delead-white.png" alt="De' Lead International">
      <img class="brand-dark" src="/assets/logo/logo-delead-dark.png" alt="De' Lead International">
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="#about">About</a>
      <div class="nav-dropdown" id="ecoDropdown">
        <button class="nav-drop-trigger" aria-expanded="false" aria-controls="ecoDropPanel">
          Ecosystem
          <svg class="nav-drop-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="nav-drop-panel" id="ecoDropPanel">
          <a href="#corporate" class="nav-drop-item">
            <span class="ndi-logo"><img src="/assets/logo/logo-delead-dark.png" alt=""></span>
            <span>Corporate Training</span>
          </a>
          <a href="https://tinkerchamps.deleadint.com" target="_blank" rel="noopener" class="nav-drop-item">
            <span class="ndi-logo"><img src="/assets/logos-verticals/tinkerchamps-logo.webp" alt=""></span>
            <span>TinkerChamps</span>
          </a>
          <a href="#makerchamps" class="nav-drop-item">
            <span class="ndi-logo"><img src="/assets/logos-verticals/makerchamps-logo.svg" alt=""></span>
            <span>MakerChamps</span>
          </a>
          <a href="#dli-education" class="nav-drop-item">
            <span class="ndi-logo"><img src="/assets/logo/logo-delead-dark.png" alt=""></span>
            <span>DLI Education</span>
          </a>
          <a href="https://goalfinder.org/" target="_blank" rel="noopener" class="nav-drop-item">
            <span class="ndi-logo"><img src="/assets/logos-verticals/goalfinder-logo.png" alt=""></span>
            <span>Goal Finder</span>
          </a>
          <a href="https://w2l.deleadint.com" target="_blank" rel="noopener" class="nav-drop-item">
            <span class="ndi-logo"><img src="/assets/logos-verticals/walk2lead-logo.svg" alt=""></span>
            <span>DLI Foundation &middot; Walk2Lead</span>
          </a>
        </div>
      </div>
      <a href="#press">Press</a>
      <a href="#voices">Voices</a>
      <a href="#gallery">Gallery</a>
      <a href="#contact">Contact</a>
    </nav>
    <div class="nav-cta">
      <a class="btn btn-primary" href="#contact">Partner With Us
        <span class="btn-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg></span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero-polaroids">
    <figure class="polaroid p1"><img src="/assets/gallery/mc-2.webp" alt=""><figcaption>MakerChamps</figcaption><a class="polaroid-link" href="#makerchamps" aria-label="Explore MakerChamps"></a></figure>
    <figure class="polaroid p2"><img src="/assets/gallery/w2l-2.webp" alt=""><figcaption>Walk2Lead</figcaption><a class="polaroid-link" href="https://w2l.deleadint.com" target="_blank" rel="noopener" aria-label="Visit the Walk2Lead website"></a></figure>
    <figure class="polaroid p3"><img src="/assets/gallery/corp-2.webp" alt=""><figcaption>Corporate Training</figcaption><a class="polaroid-link" href="#corporate" aria-label="Explore Corporate Training"></a></figure>
    <figure class="polaroid p4"><img src="/assets/gallery/tc-1.webp" alt=""><figcaption>TinkerChamps</figcaption><a class="polaroid-link" href="https://tinkerchamps.deleadint.com" target="_blank" rel="noopener" aria-label="Visit the TinkerChamps website"></a></figure>
  </div>

  <div class="hero-inner container">
    <div class="hero-top">
      <span class="hero-accent" aria-hidden="true">
        <svg viewBox="0 0 64 16" fill="none"><path d="M1 8c6-8 12 8 18 0s12 8 18 0 12 8 18 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </span>
      <span class="eyebrow on-dark">Education &middot; Technology &middot; Leadership</span>
      <span class="hero-accent" aria-hidden="true">
        <svg viewBox="0 0 64 16" fill="none"><path d="M1 8c6-8 12 8 18 0s12 8 18 0 12 8 18 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </span>
    </div>
    <h1 class="reveal in">Where learning is <em>lived</em>, not lectured.</h1>
    <div class="hero-actions reveal in">
      <a href="#ecosystem" class="btn btn-cream">See the ecosystem
        <span class="btn-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg></span>
      </a>
      <a href="#contact" class="btn btn-ghost on-dark">Talk to us</a>
    </div>
  </div>
</section>

<!-- ============ HERO STATS BAND ============ -->
<section class="hero-stat-band">
  <div class="container hero-stat-band-inner">
    <div class="stat-item reveal"><b>5000+</b><i></i><span>Students Impacted</span></div>
    <div class="stat-item reveal"><b>1000+</b><i></i><span>Professionals Trained</span></div>
    <div class="stat-item reveal"><b>50+</b><i></i><span>Organisations Collaborated</span></div>
  </div>
</section>

<!-- ============ ASSOCIATIONS MARQUEE ============ -->
<section class="assoc">
  <div class="container">
    <p class="assoc-label">Schools, foundations and companies we've worked with</p>
  </div>
  <div class="marquee">
    <div class="marquee-track">
      <img src="/assets/logos/institutions/pulliyil.webp" alt="Partner institution crest" loading="lazy">
      <img src="/assets/logos/institutions/veembour.webp" alt="Partner institution crest" loading="lazy">
      <img src="/assets/logos/institutions/mundothuparamba.webp" alt="Partner institution crest" loading="lazy">
      <img src="/assets/logos/institutions/thavanur.webp" alt="Partner institution crest" loading="lazy">
      <img src="/assets/logos/institutions/thirkkulam.webp" alt="Partner institution crest" loading="lazy">
      <img src="/assets/logos/institutions/aura.png" alt="Aura Global Schools" loading="lazy">
      <span class="marquee-badge">DP World</span>
      <span class="marquee-badge">Kayzan Group</span>
      <span class="marquee-badge">RAG Business Hub</span>
      <span class="marquee-badge">Al Ahalia Group</span>
      <!-- duplicate for seamless loop -->
      <img src="/assets/logos/institutions/pulliyil.webp" alt="" aria-hidden="true" loading="lazy">
      <img src="/assets/logos/institutions/veembour.webp" alt="" aria-hidden="true" loading="lazy">
      <img src="/assets/logos/institutions/mundothuparamba.webp" alt="" aria-hidden="true" loading="lazy">
      <img src="/assets/logos/institutions/thavanur.webp" alt="" aria-hidden="true" loading="lazy">
      <img src="/assets/logos/institutions/thirkkulam.webp" alt="" aria-hidden="true" loading="lazy">
      <img src="/assets/logos/institutions/aura.png" alt="" aria-hidden="true" loading="lazy">
      <span class="marquee-badge" aria-hidden="true">DP World</span>
      <span class="marquee-badge" aria-hidden="true">Kayzan Group</span>
      <span class="marquee-badge" aria-hidden="true">RAG Business Hub</span>
      <span class="marquee-badge" aria-hidden="true">Al Ahalia Group</span>
    </div>
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="about" id="about">
  <div class="container">
    <div class="about-panel reveal">
      <div class="about-copy about-copy-top">
        <span class="eyebrow">About Us</span>
        <h2>An education segment, reforming itself</h2>
        <p>Founded in 2022, De&rsquo; Lead International is a trailblazer in reshaping education, moving beyond traditional classrooms with technology-driven programmes, career mentoring, leadership development and corporate training.</p>
        <p>We understand the concerns of students, parents and professionals in a rapidly changing world. With experienced mentors and a hands-on philosophy, we deliver quality education across both online and offline modes, empowering learners to become agents of social impact, not just exam-takers.</p>
        <a href="#ecosystem" class="link-arrow about-cta">See how our verticals work together
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
        </a>
      </div>

      <div class="method-rows">
        <div class="method-row mr-1">
          <span class="mr-num">01</span>
          <div class="mr-copy"><h4>Our Mission</h4><p>To make learning experiential and future-ready, equipping students and professionals with the technology, leadership and life skills a rapidly changing world actually asks for, not just a syllabus.</p></div>
        </div>
        <div class="method-row mr-2">
          <span class="mr-num">02</span>
          <div class="mr-copy"><h4>Our Vision</h4><p>To be the region's most trusted education-innovation partner, carrying that same hands-on philosophy from one classroom in Kozhikode to camps, CSR programmes and corporate tracks across India and the UAE.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ ECOSYSTEM : scroll-stacked vertical cards ============ -->
<section class="eco-intro">
  <span class="eco-arc" aria-hidden="true">
    <svg viewBox="0 0 220 480" fill="none"><path d="M210 10C120 60 40 160 40 260s70 180 150 210" stroke="currentColor" stroke-width="2" stroke-dasharray="8 10" stroke-linecap="round"/></svg>
  </span>
  <div class="container eco-intro-inner reveal">
    <span class="eco-script">Six verticals, one idea</span>
    <h2 class="eco-h2">Climb the ecosystem<br>with us!</h2>
    <p>Each vertical wears its own name, its own logo, its own colours. All of them exist because we think people learn by doing, not by being told.</p>
    <a href="#corporate" class="circle-cta eco-glow"><span>START</span><span>EXPLORING</span></a>
  </div>
</section>

<div id="ecosystem" class="v-stack">

<!-- Corporate Training : De' Lead's own brand -->
<section class="v-card" id="corporate" style="--v-bg:#4a0330;--v-fg:#fff;">
  <div class="v-card-inner container">
    <div class="vc-brand vc-brand-split">
      <img class="vc-logo" src="/assets/logo/logo-delead-white.png" alt="De' Lead International">
      <span class="vc-brand-sub">Corporate Training</span>
    </div>
    <p class="vc-eyebrow">Leadership &middot; Team Building &middot; Outbound</p>
    <p class="vc-desc">Directed by Arjun C P and Sabarinath K, our corporate arm runs leadership development, team building and outbound training for organisations across India and the UAE. Strategy sessions in boardrooms, confidence-building on horseback.</p>
    <div class="v-stats">
      <div><b>4+</b><span>Corporate clients</span></div>
      <div><b>7</b><span>Programmes since 2023</span></div>
      <div><b>2</b><span>Countries, India &amp; UAE</span></div>
    </div>
  </div>
  <span class="vc-numeral">01</span>
  <div class="vc-right">
    <div class="vc-media"><img src="/assets/gallery/corp-suit.webp" alt="A client leadership team after a De' Lead corporate session"></div>
    <a href="#contact" class="vc-badge">Know more</a>
  </div>
</section>

<!-- DLI Foundation / Walk2Lead : real red from w2l css, real logo -->
<section class="v-card" id="dli-foundation" style="--v-bg:#c81c1c;--v-fg:#fff;--v-font:'Lora',serif;--v-fw:700;--v-fstyle:italic;">
  <div class="v-card-inner container">
    <div class="vc-brand">
      <img class="vc-logo" src="/assets/logos-verticals/walk2lead-logo-white.svg" alt="Walk2Lead" style="width:100%;max-width:520px;height:auto;filter:brightness(0) invert(1);">
    </div>
    <p class="vc-eyebrow">Walk2Lead &middot; CSR</p>
    <p class="vc-desc">Our CSR arm's flagship programme, <b>Walk2Lead</b>, brings hands-on robotics, coding and AI into rural government schools across Kerala. Funded by Walkaroo Foundation, implemented end-to-end by De&rsquo; Lead.</p>
    <div class="v-stats">
      <div><b>44</b><span>Schools implemented</span></div>
      <div><b>1,300+</b><span>Students reached</span></div>
      <div><b>4</b><span>Districts in Kerala</span></div>
    </div>
  </div>
  <span class="vc-numeral">02</span>
  <div class="vc-right">
    <div class="vc-media"><img src="/assets/images/card-walk2lead.jpg" alt="Walk2Lead CSR robotics programme"></div>
    <a href="https://w2l.deleadint.com" target="_blank" rel="noopener" class="vc-badge">Visit site</a>
  </div>
</section>

<!-- TinkerChamps : real brand colors from tinkerchamps.deleadint.com -->
<section class="v-card" id="tinkerchamps" style="--v-bg:#5021b0;--v-fg:var(--tc-yellow);--v-font:'Covered By Your Grace',cursive;--v-fw:400;">
  <div class="v-card-inner container">
    <div class="vc-brand">
      <img class="vc-logo" src="/assets/logos-verticals/tinkerchamps-logo.webp" alt="TinkerChamps" style="width:100%;max-width:520px;height:auto;">
    </div>
    <p class="vc-eyebrow">Residential Experiential Camps</p>
    <p class="vc-desc">A 3-day premium experiential learning camp, plus a 2-day @School format, that helps students from grades 6&ndash;12 think sharper, lead better and design their own future. High ropes, team challenges, robotics &amp; AI.</p>
    <div class="v-stats">
      <div><b>20+</b><span>Seasons completed</span></div>
      <div><b>500+</b><span>Students attended</span></div>
      <div><b>50+</b><span>Hands-on activities</span></div>
    </div>
  </div>
  <span class="vc-numeral">03</span>
  <div class="vc-right">
    <div class="vc-media"><img src="/assets/images/card-tinkerchamps.jpg" alt="TinkerChamps residential camp activity"></div>
    <a href="https://tinkerchamps.deleadint.com" target="_blank" rel="noopener" class="vc-badge">Visit site</a>
  </div>
</section>

<!-- MakerChamps : navy / orange / lime, paper-cut, matching the MakerChamps site -->
<section class="v-card" id="makerchamps" style="--v-bg:#021e5d;--v-fg:#fff;--v-font:'Bricolage Grotesque',sans-serif;--v-fw:700;">
  <div class="v-card-inner container">
    <div class="vc-brand">
      <img class="vc-logo" src="/assets/logos-verticals/makerchamps-logo-white.svg" alt="MakerChamps" style="width:100%;max-width:440px;height:auto;">
    </div>
    <p class="vc-eyebrow">Think &middot; Make &middot; Transform</p>
    <p class="vc-desc">A 2-day residential innovation bootcamp on the NIT Calicut campus, run with Nlightened ZenSolutions (incubated inside NIT Calicut's own Technology Business Incubator). Seven hands-on modules, real labs, real engineers.</p>
    <div class="v-stats">
      <div><b>60</b><span>Seats per season, max</span></div>
      <div><b>7</b><span>Modules, 2 days</span></div>
      <div><b>#1</b><span>NIT in Kerala, NIRF top</span></div>
    </div>
  </div>
  <span class="vc-numeral">04</span>
  <div class="vc-right">
    <span class="torn-triangle" aria-hidden="true"></span>
    <div class="vc-media"><img src="/assets/gallery/mc-1.webp" alt="MakerChamps innovation bootcamp"></div>
    <a href="#contact" class="vc-badge">Know more</a>
  </div>
</section>

<!-- DLI Education : blue -->
<section class="v-card" id="dli-education" style="--v-bg:#142653;--v-fg:#fff;--v-accent:#29bac1;--v-font:'Space Grotesk',sans-serif;--v-fw:700;">
  <div class="v-card-inner container">
    <div class="vc-brand vc-brand-split">
      <img class="vc-logo" src="/assets/logo/logo-delead-white.png" alt="De' Lead International">
      <span class="vc-brand-sub">DLI Education</span>
    </div>
    <p class="vc-eyebrow">DLI Students &middot; DLI Professionals</p>
    <p class="vc-desc"><b>Students</b>: Python, Web Dev, Robotics, 3D Design, Block Coding &amp; Gen AI. <b>Professionals</b>: Gen AI for Educators &amp; HR, design thinking, leadership. Online, offline, camps or corporate workshops.</p>
    <div class="v-stats">
      <div><b>2000+</b><span>Students trained</span></div>
      <div><b>8+</b><span>Course tracks</span></div>
      <div><b>4</b><span>Delivery modes</span></div>
    </div>
  </div>
  <span class="vc-numeral">05</span>
  <div class="vc-right">
    <div class="vc-media"><img src="/assets/gallery/dli-2.webp" alt="DLI Education classroom session"></div>
    <a href="#contact" class="vc-badge">Know more</a>
  </div>
</section>

<!-- Goal Finder : indigo -->
<section class="v-card" id="goal-finder" style="--v-bg:#0145d5;--v-fg:#fff;--v-accent:#72c045;--v-font:'Manrope',sans-serif;--v-fw:800;">
  <div class="v-card-inner container">
    <div class="vc-brand">
      <img class="vc-logo" src="/assets/logos-verticals/goalfinder-logo-white.png" alt="Goal Finder" style="height:132px;">
    </div>
    <p class="vc-eyebrow">AI Career-Profiling Platform</p>
    <p class="vc-desc">A psychometric personality assessment, powered by AI, for students and professionals alike. Career matches, a career library, top colleges in India and abroad, entrance-exam timelines and scholarships.</p>
    <div class="v-stats">
      <div><b>AI</b><span>+ psychometric testing</span></div>
      <div><b>Global</b><span>College matches, India &amp; abroad</span></div>
      <div><b>2</b><span>Students &amp; pros</span></div>
    </div>
  </div>
  <span class="vc-numeral">06</span>
  <div class="vc-right">
    <div class="vc-media"><img src="/assets/images/about-story.jpg" alt="Student career guidance session"></div>
    <a href="https://goalfinder.org/" target="_blank" rel="noopener" class="vc-badge">Visit site</a>
  </div>
</section>

</div>

<!-- ============ ACHIEVEMENTS / PRESS ============ -->
<section class="press" id="press">
  <div class="container">
    <div class="press-top">
      <div class="section-head reveal">
        <span class="eyebrow">Achievements &amp; Press</span>
        <h2>Recognised beyond the classroom</h2>
        <p>A few milestones from the De&rsquo; Lead journey, and the local press that's covered our schools along the way.</p>
      </div>

      <div class="press-chips reveal-stagger">
        <span class="press-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 6.5 7 1-5 5 1.5 7L12 18l-6.5 3.5L7 14.5l-5-5 7-1z"/></svg>Top 2 international ranking at TechTop 2025, Maker Village Kochi</span>
        <span class="press-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 6.5 7 1-5 5 1.5 7L12 18l-6.5 3.5L7 14.5l-5-5 7-1z"/></svg>State-level recognition, Kerala General Education Dept.</span>
        <span class="press-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 6.5 7 1-5 5 1.5 7L12 18l-6.5 3.5L7 14.5l-5-5 7-1z"/></svg>Sharjah Award for Educational Excellence: Evana Eliza Vinoj, DLI Education, UAE</span>
      </div>
    </div>
    </div>

    <div class="press-strip reveal">
      <div class="press-track">
        <img src="/assets/press/press-1.webp" alt="Walk2Lead newspaper coverage" loading="lazy">
        <img src="/assets/press/press-2.webp" alt="Walk2Lead newspaper coverage" loading="lazy">
        <img src="/assets/press/press-3.webp" alt="Walk2Lead newspaper coverage" loading="lazy">
        <img src="/assets/press/press-4.webp" alt="Walk2Lead newspaper coverage" loading="lazy">
        <img src="/assets/press/press-5.webp" alt="Walk2Lead newspaper coverage" loading="lazy">
        <img src="/assets/press/press-6.webp" alt="Walk2Lead newspaper coverage" loading="lazy">
      </div>
      <div class="press-track" aria-hidden="true">
        <img src="/assets/press/press-1.webp" alt="" loading="lazy">
        <img src="/assets/press/press-2.webp" alt="" loading="lazy">
        <img src="/assets/press/press-3.webp" alt="" loading="lazy">
        <img src="/assets/press/press-4.webp" alt="" loading="lazy">
        <img src="/assets/press/press-5.webp" alt="" loading="lazy">
        <img src="/assets/press/press-6.webp" alt="" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- ============ VOICES / TESTIMONIALS : pinned headline + stacked cards ============ -->
<section class="voices" id="voices">
  <div class="container voices-layout">
    <div class="voices-pin reveal">
      <span class="eyebrow">What People Notice</span>
      <h2>Not our words, theirs</h2>
      <p>Voices from the schools, parents and companies we've worked with.</p>
    </div>

    <div class="voices-stack">
      <div class="voice-stackcard" style="--vsc-bg:var(--cream2);--vsc-fg:var(--ink);">
        <span class="vsc-num">01</span>
        <p class="vsc-quote">&ldquo;Gone are the days of shy students hiding in the back. TinkerChamps fostered collaboration and communication, making my classroom a vibrant hub of social learning and growth.&rdquo;</p>
        <div class="vsc-who"><span class="vsc-avatar">RJ</span><div><b>Roshan John</b><span>Project Coordinator, PRISM, on TinkerChamps</span></div></div>
      </div>
      <div class="voice-stackcard" style="--vsc-bg:var(--ink);--vsc-fg:#fff;">
        <span class="vsc-num">02</span>
        <p class="vsc-quote">&ldquo;Being from a non-IT background I thought it would be difficult to learn to code, but De&rsquo; Lead helped me get the concepts easily, in a fun-filled way.&rdquo;</p>
        <div class="vsc-who"><span class="vsc-avatar">SC</span><div><b>Soumya C.</b><span>Civil Engineer &rarr; Python Developer, on DLI Education</span></div></div>
      </div>
      <div class="voice-stackcard" style="--vsc-bg:var(--magenta-deep);--vsc-fg:#fff;">
        <span class="vsc-num">03</span>
        <p class="vsc-quote">&ldquo;It's my pleasure to use GoalFinder, a powerful tool to identify strengths and areas for improvement. I highly recommend it to my students.&rdquo;</p>
