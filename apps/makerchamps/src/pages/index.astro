---
const LEAD_ENDPOINT = import.meta.env.PUBLIC_LEAD_ENDPOINT || "https://admin.deleadint.com/api/lead";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MakerChamps — Residential Innovation Bootcamp at NIT Calicut | De' Lead International</title>
<meta name="description" content="A 2-day residential innovation bootcamp on the NIT Calicut campus for class 8–12 students. Only 60 seats per season. By De' Lead International × Nlightened ZenSolutions.">
<link rel="canonical" href="https://mc.deleadint.com/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="MakerChamps">
<meta property="og:title" content="MakerChamps — Residential Innovation Bootcamp at NIT Calicut | De' Lead International">
<meta property="og:description" content="A 2-day residential innovation bootcamp on the NIT Calicut campus for class 8–12 students. Only 60 seats per season. By De' Lead International × Nlightened ZenSolutions.">
<meta property="og:url" content="https://mc.deleadint.com/">
<meta property="og:image" content="https://mc.deleadint.com/assets/brand/makerchamps-logo.png">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="MakerChamps — Residential Innovation Bootcamp at NIT Calicut | De' Lead International">
<meta name="twitter:description" content="A 2-day residential innovation bootcamp on the NIT Calicut campus for class 8–12 students. Only 60 seats per season. By De' Lead International × Nlightened ZenSolutions.">
<meta name="twitter:image" content="https://mc.deleadint.com/assets/brand/makerchamps-logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="icon" href="/favicon.png">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav class="nav">
  <div class="container">
    <a href="#top" class="nav-logo">
      <img src="/assets/brand/makerchamps-logo-on-dark.webp" alt="MakerChamps">
    </a>
    <div class="nav-links">
      <a href="#modules">Modules</a>
      <a href="#backers">Why NIT</a>
      <a href="#safety">Safety</a>
      <a href="#gallery">Gallery</a>
      <a href="#testimonials">Stories</a>
    </div>
    <a href="#enquire" class="btn btn-primary nav-cta">Enquire Now</a>
    <button class="nav-toggle" id="navToggle" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
  <div class="nav-mobile-panel" id="navMobilePanel">
    <a href="#modules">Modules</a>
    <a href="#backers">Why NIT</a>
    <a href="#safety">Safety</a>
    <a href="#gallery">Gallery</a>
    <a href="#testimonials">Stories</a>
    <a href="#enquire" class="btn btn-primary">Enquire Now</a>
  </div>
</nav>

<header class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-grid">
      <span class="hero-eyebrow">Think · Make · Transform</span>
      <h1 class="hero-mega">
        <span class="line">TWO DAYS ON</span>
        <span class="line callout">NIT CALICUT CAMPUS</span>
        <span class="line">THAT SHOW WHO</span>
        <span class="line fill-orange">THEY CAN BECOME</span>
      </h1>

      <div class="hero-collage">
        <div class="hero-photo-wrap">
          <div class="hero-photo-back torn">
            <img src="/assets/photos/orientation-auditorium.webp" alt="Students at MakerChamps orientation inside an NIT Calicut auditorium" loading="eager">
          </div>
          <div class="hero-photo-inner torn">
            <img src="/assets/photos/nit-calicut-gate.webp" alt="NIT Calicut campus gate with the National Institute of Technology Calicut signboard" loading="eager" style="object-position: right center;">
          </div>
          <span class="torn-triangle"></span>
          <!-- Invite card: only rendered when a next batch is scheduled. Remove this block entirely between seasons. -->
          <a href="#enquire" class="invite-card">
            <img class="invite-logo" src="/assets/brand/season-3-logo.webp" alt="MakerChamps Season 3">
            <span class="invite-label">You're Invited</span>
            <span class="invite-date">Aug 28–29</span>
            <span class="invite-loc">NIT Calicut Campus</span>
          </a>
        </div>
      </div>

      <div class="hero-actions">
        <a href="#enquire" class="btn btn-primary">Reserve a Seat</a>
        <a href="#modules" class="btn btn-ghost-light">See What They'll Do</a>
      </div>
      <div class="hero-microstats">
        <div>
          <span class="micro-label">WHEN &amp; WHERE</span>
          <span class="micro-val">Aug 28–29 · NIT Calicut Campus, Kozhikode</span>
        </div>
        <div>
          <span class="micro-label">WHAT TO EXPECT</span>
          <span class="micro-val">7 hands-on modules · Real NIT lab access · Only 60 seats</span>
        </div>
      </div>
    </div>
  </div>
  <svg class="hero-bg-icon" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5" style="color:var(--mc-lime)">
    <circle cx="50" cy="42" r="26"/>
    <path d="M40 42a10 10 0 0120 0c0 5-3 7-4 11H44c-1-4-4-6-4-11z"/>
    <line x1="42" y1="60" x2="58" y2="60"/>
    <line x1="44" y1="66" x2="56" y2="66"/>
  </svg>
</header>

<section class="section about" id="about">
  <div class="pattern-bg on-light"></div>
  <div class="container about-grid">
    <div class="section-head reveal">
      <span class="eyebrow">What is MakerChamps</span>
      <h2>Exposure that <span class="italic">widens how they think.</span></h2>
      <p class="lede">Before it's about building anything, MakerChamps is about your child stepping onto a top-ranked engineering campus and realising what's possible. They sit in NIT Calicut's classrooms, walk its labs, and meet the people who research there — an exposure that widens their sense of what they could become. The making, the pitching, the prototypes — that's how they prove it to themselves.</p>
    </div>
    <div class="about-collage reveal">
      <div class="about-photo-main torn">
        <img src="/assets/photos/isro-exhibit-tour.webp" alt="Students on a space-research exhibit tour at NIT Calicut">
      </div>
      <div class="about-photo-accent torn">
        <img src="/assets/photos/chemistry-lab-handson.webp" alt="Hands-on chemistry session at MakerChamps">
      </div>
    </div>
  </div>
</section>

<section class="invite">
  <div class="container reveal">
    <blockquote>Every parent sees it — the spark at the dinner table, the questions that never stop, the ideas that come from nowhere. <span class="accent">NIT Calicut is where that spark becomes real</span> — MakerChamps is how we get them there.</blockquote>
    <cite>An invitation from De' Lead International</cite>
  </div>
</section>

<section class="section shift">
  <div class="pattern-bg on-dark"></div>
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow" style="color:var(--mc-lime)">In two days, something shifts</span>
      <h2>You won't see the change in a certificate</h2>
      <p class="lede">You'll see it in how they talk, what they want, and how they carry themselves. Here's what parents tell us they notice.</p>
    </div>
    <div class="shift-list reveal-stagger">
      <div class="shift-row stagger-item">
        <div class="shift-before">"I don't know what I want to be"</div>
        <div class="shift-arrow">→</div>
        <div class="shift-after">"I want to build solutions to real problems"</div>
      </div>
      <div class="shift-row stagger-item">
        <div class="shift-before">Hesitant to speak in class</div>
        <div class="shift-arrow">→</div>
        <div class="shift-after">Pitches an idea to a room full of people</div>
      </div>
      <div class="shift-row stagger-item">
        <div class="shift-before">Waits for the teacher to give the answer</div>
        <div class="shift-arrow">→</div>
        <div class="shift-after">Spots a problem and builds a solution</div>
      </div>
      <div class="shift-row stagger-item">
        <div class="shift-before">Studying to pass exams</div>
        <div class="shift-arrow">→</div>
        <div class="shift-after">Studying with a reason, to build something</div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="modules">
  <div class="pattern-bg on-light"></div>
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Inside MakerChamps</span>
      <h2>7 modules, <span class="italic">skills for life</span></h2>
      <p class="lede">Not lectures, not slides. Seven hands-on experiences where your child does, makes, and presents.</p>
    </div>
    <div class="modules-grid reveal-stagger">
      <div class="module-card set-a stagger-item">
        <span class="torn-triangle"></span>
        <span class="num">01</span>
        <h3>Expert Mentors &amp; Real-World Insights</h3>
        <p>Learn from international trainers, NIT professors and students, and NIT-TBI founders through expert sessions and real experiences.</p>
      </div>
      <div class="module-card set-a stagger-item">
        <span class="torn-triangle"></span>
        <span class="num">02</span>
        <h3>NIT Campus Exploration &amp; Lab Visits</h3>
        <p>Guided campus walks and lab visits with researchers, helping your child see real innovation up close.</p>
      </div>
      <div class="module-card set-a stagger-item">
        <span class="torn-triangle"></span>
        <span class="num">03</span>
        <h3>Team Management &amp; Leadership Skills</h3>
        <p>Mixed teams teach your child to lead, listen, and collaborate under real conditions.</p>
      </div>
      <div class="module-card stagger-item">
        <span class="torn-triangle"></span>
        <span class="num">04</span>
        <h3>STEM Learning &amp; Science Experiments</h3>
        <p>Physics and chemistry that spark real "aha" moments. Science becomes adventure, not a textbook.</p>
      </div>
      <div class="module-card stagger-item">
        <span class="torn-triangle"></span>
        <span class="num">05</span>
        <h3>Design Thinking &amp; Entrepreneurship</h3>
        <p>The same framework used at IDEO and Stanford. They learn to solve problems the way innovators do.</p>
      </div>
      <div class="module-card stagger-item">
        <span class="torn-triangle"></span>
        <span class="num">06</span>
        <h3>Maker Mindset &amp; Prototype Building</h3>
        <p>They go home with something built by their own hands. Real materials, real creation.</p>
      </div>
      <div class="module-card featured stagger-item">
        <span class="torn-triangle"></span>
        <span class="num">07</span>
        <h3>Entrepreneur Idea Pitching Training</h3>
        <p>Stand up. Speak clearly. Sell the idea. The one skill that opens every door.</p>
      </div>
    </div>
  </div>
</section>

<section class="section backers" id="backers">
  <div class="pattern-bg on-light"></div>
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Who's behind it</span>
      <h2>Built by innovators, <span class="italic">backed by NIT Calicut</span></h2>
      <p class="lede">An experience like this is only as good as the people and the campus behind it. This is what makes the exposure real, not staged.</p>
    </div>
    <div class="backers-grid">
      <div class="reveal">
        <div class="backer-orgs">
          <div class="backer-org">
            <img class="backer-org-logo" src="/assets/brand/dli-logo-color.webp" alt="De' Lead International">
            <h4>De' Lead International</h4>
            <p>A forward-thinking learning organisation shaping the next generation through hands-on, experiential learning across India and the UAE — the team that designs and runs every MakerChamps batch.</p>
          </div>
          <div class="backer-org">
            <img class="backer-org-logo" src="/assets/brand/nlightened-logo.png" alt="Nlightened ZenSolutions LLP">
            <h4>Nlightened ZenSolutions</h4>
            <p>A technology startup incubated inside NIT Calicut's Technology Business Incubator. This program runs from within NIT itself — not an outside group renting a venue.</p>
          </div>
          <div class="backer-org">
            <img class="backer-org-logo" src="/assets/brand/nit-holistic-centre-logo.png" alt="Centre for Holistic Teaching and Learning, NIT Calicut">
            <h4>Centre for Holistic Teaching &amp; Learning</h4>
            <p>NIT Calicut's own centre for holistic student development. MakerChamps runs in association with them — that's what gets your child real access to NIT's classrooms, labs, and faculty, not a rented hall nearby.</p>
          </div>
        </div>
      </div>
      <div class="backer-side">
        <div class="directors reveal">
          <div class="director-card">
            <img src="/assets/photos/director-arjun-cp.webp" alt="Arjun C P">
            <div class="name">Arjun C P</div>
            <div class="role">Director, De' Lead International</div>
          </div>
          <div class="director-card">
            <img src="/assets/photos/director-sabarinath-k.webp" alt="Sabarinath K">
            <div class="name">Sabarinath K</div>
            <div class="role">Director, De' Lead International</div>
          </div>
        </div>
        <div class="backer-stat reveal">
          <svg class="stat-bg-icon" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3">
            <path d="M50 10L90 30v40L50 90 10 70V30z"/>
            <path d="M10 30l40 20 40-20M50 50v40"/>
          </svg>
          <div class="big">#1</div>
          <p>NIT in Kerala, NIRF top-ranked — and where your child spends two days building, not just visiting.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section safety" id="safety">
  <div class="pattern-bg on-light"></div>
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Your peace of mind</span>
      <h2>Your child is <span class="italic">safe with us</span></h2>
      <p class="lede">We know what it means to send your child away overnight. So we've thought through every detail.</p>
    </div>
    <div class="safety-grid reveal-stagger">
      <div class="safety-card stagger-item">
        <span class="torn-triangle"></span>
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/></svg></div>
        <h3>Supervised, always</h3>
        <p>Mentors and faculty monitor every session. Your child never goes unsupervised on campus.</p>
      </div>
      <div class="safety-card stagger-item">
        <span class="torn-triangle"></span>
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg></div>
        <h3>Safe overnight stay</h3>
        <p>Supervised on-campus accommodation, with separate arrangements for boys and girls, and mentors close by through the night.</p>
      </div>
      <div class="safety-card stagger-item">
        <span class="torn-triangle"></span>
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg></div>
        <h3>Staying in touch, the right way</h3>
        <p>Every group has its own assigned mentor who shares updates at set times, so the days stay focused and phone-free. One message away if you ever need to reach your child.</p>
      </div>
      <div class="safety-card stagger-item">
        <span class="torn-triangle"></span>
        <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2v20M6 2a4 4 0 000 8M18 2v20M18 8a4 4 0 000-6"/></svg></div>
        <h3>Meals and rest, built in</h3>
        <p>Veg and non-veg options for every meal, with dedicated prayer, freshen-up and rest time each day.</p>
      </div>
    </div>
    <div class="safety-chips reveal">
      <span>Laptops welcome</span>
      <span>Max 60 students</span>
      <span>Completion certificate</span>
      <span>Class 8 to 12</span>
    </div>
  </div>
</section>

<section class="section gallery" id="gallery">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Inside a batch</span>
      <h2>What two days on campus <span class="italic">actually looks like</span></h2>
    </div>
  </div>
  <div class="marquee-wrap reveal">
    <div class="marquee-row marquee-left">
      <div class="marquee-track">
        <img src="/assets/photos/orientation-auditorium.webp" alt="Orientation session in an NIT Calicut auditorium" loading="lazy">
        <img src="/assets/photos/isro-exhibit-tour.webp" alt="Students on a guided space-research exhibit tour" loading="lazy">
        <img src="/assets/photos/chandrayaan-lander-demo.webp" alt="Mentor explaining a Chandrayaan lander model to students" loading="lazy">
        <img src="/assets/photos/electronics-lab-visit.webp" alt="Students visiting an NIT electronics research lab" loading="lazy">
        <img src="/assets/photos/orientation-auditorium.webp" alt="" aria-hidden="true" loading="lazy">
        <img src="/assets/photos/isro-exhibit-tour.webp" alt="" aria-hidden="true" loading="lazy">
        <img src="/assets/photos/chandrayaan-lander-demo.webp" alt="" aria-hidden="true" loading="lazy">
        <img src="/assets/photos/electronics-lab-visit.webp" alt="" aria-hidden="true" loading="lazy">
      </div>
    </div>
    <div class="marquee-row marquee-right">
      <div class="marquee-track">
        <img src="/assets/photos/chemistry-lab-handson.webp" alt="Hands-on chemistry experiment session" loading="lazy">
        <img src="/assets/photos/prototype-building.webp" alt="Students building a prototype with real materials" loading="lazy">
        <img src="/assets/photos/physics-demo-pascals-law.webp" alt="Live physics demonstration on stage" loading="lazy">
        <img src="/assets/photos/nit-team-huddle.webp" alt="Team huddle inside an NIT Calicut hall" loading="lazy">
        <img src="/assets/photos/chemistry-lab-handson.webp" alt="" aria-hidden="true" loading="lazy">
        <img src="/assets/photos/prototype-building.webp" alt="" aria-hidden="true" loading="lazy">
        <img src="/assets/photos/physics-demo-pascals-law.webp" alt="" aria-hidden="true" loading="lazy">
        <img src="/assets/photos/nit-team-huddle.webp" alt="" aria-hidden="true" loading="lazy">
      </div>
    </div>
  </div>
</section>

<section class="section testimonials" id="testimonials">
  <div class="pattern-bg on-dark"></div>
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow" style="color:var(--mc-lime)">This is what we hear</span>
      <h2>From parents. From students. <span class="italic">From the MakerChamps experience.</span></h2>
    </div>
    <div class="testimonial-grid reveal-stagger">
      <div class="testimonial-card stagger-item">
        <span class="quote-mark">"</span>
        <p>My daughter Meenakshi had an absolutely fantastic time. Beyond just the lessons, this bootcamp has been truly transformative — we've seen a remarkable boost in her confidence. Getting to explore a premier institution like NIT Calicut, attend live classes, and work in the actual labs was a dream come true for her.</p>
        <cite>Soorajnath<span>Parent of Meenakshi</span></cite>
      </div>
      <div class="testimonial-card stagger-item">
        <span class="quote-mark">"</span>
        <p>The students thoroughly enjoyed the sessions and found the experience truly encouraging. They have so many valuable takeaways — it's wonderful to see how happy and inspired they are. We sincerely appreciate all the time, effort, and passion the team put into making these sessions so meaningful.</p>
        <cite>Program Partner<span>MakerChamps Season 2</span></cite>
      </div>
      <div class="testimonial-card stagger-item">
        <span class="quote-mark">"</span>
        <p>My son Hashim wasn't very enthusiastic going in — but the transformation over just two days was remarkable. He came home more energetic, more confident, more inspired, and told me: "I don't want to study in a normal college anymore. I have to crack JEE and get into a really good college — I have to work." For me, that shift in mindset was the greatest achievement of this program.</p>
        <cite>Safiya Cheruvakkath<span>Parent of Muhammed Hashim, Grade XI</span></cite>
      </div>
      <div class="testimonial-card stagger-item">
        <span class="quote-mark">"</span>
        <p>The two-day camp was a wonderful event — my son loved it. Since he dreams of studying at an NIT, he was thrilled to visit the campus and take part. In an era where children are confined to their phones, camps like this are exactly what helps the new generation build real social connections. Please conduct more programs like this.</p>
        <cite>Parent of Rizwan Khan<span>Translated from a Malayalam voice message</span></cite>
      </div>
    </div>
  </div>
</section>

<section class="section cta" id="enquire">
  <div class="container cta-inner">
    <div class="reveal">
      <span class="eyebrow" style="color:var(--mc-lime)">Only 60 seats per season</span>
      <h2 class="section-head" style="margin-bottom:0">Give them two days that <span class="italic">change how they see themselves</span></h2>
      <p class="lede" style="margin-top:14px;max-width:48ch">Reach out directly, or leave your details and our team will call you back.</p>
      <div class="cta-quick" style="margin-top:28px">
        <a href="https://wa.me/918075566081?text=Hi%2C%20I%27d%20like%20to%20know%20more%20about%20MakerChamps" class="btn btn-whatsapp" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.32A7.85 7.85 0 0012.05 4a7.94 7.94 0 00-6.9 11.9L4 20l4.2-1.1a7.9 7.9 0 003.85 1h.01a7.94 7.94 0 007.94-7.94 7.9 7.9 0 00-2.4-5.64zm-5.55 12.2a6.6 6.6 0 01-3.36-.92l-.24-.14-2.5.65.67-2.44-.16-.25a6.6 6.6 0 1112.28-3.5 6.6 6.6 0 01-6.69 6.6zm3.62-4.94c-.2-.1-1.17-.58-1.35-.64s-.31-.1-.45.1-.53.64-.65.77-.24.15-.44.05a5.4 5.4 0 01-1.6-.99 6 6 0 01-1.1-1.37c-.12-.2 0-.3.09-.4.09-.1.2-.24.3-.36.1-.12.13-.2.2-.34.07-.14.03-.26-.02-.36s-.45-1.08-.62-1.48c-.16-.39-.33-.34-.45-.34h-.38a.73.73 0 00-.53.25c-.18.2-.7.68-.7 1.66s.72 1.93.82 2.06c.1.14 1.4 2.14 3.4 3 .48.2.85.33 1.14.42.48.15.92.13 1.26.08.39-.06 1.17-.48 1.34-.94.16-.46.16-.86.11-.94-.05-.08-.18-.13-.38-.23z"/></svg>
          WhatsApp Us
        </a>
        <a href="mailto:info@deleadint.com?subject=MakerChamps%20Enquiry" class="btn btn-light">Email Us</a>
      </div>
      <p style="margin-top:24px;font-size:0.85rem;opacity:0.7">
        Or call India <strong>+91 807 556 6081</strong>
      </p>
    </div>

    <form data-lead-source="makerchamps" class="cta-form reveal" id="enquiryForm">
      <h3>Enquire about the next season</h3>
      <div class="form-row">
        <div class="field">
          <label for="parentName">Parent's Name</label>
          <input type="text" id="parentName" name="parentName" required>
        </div>
        <div class="field">
          <label for="childClass">Child's Class</label>
          <select id="childClass" name="childClass" required>
            <option value="" disabled selected>Select class</option>
            <option>8</option>
            <option>9</option>
