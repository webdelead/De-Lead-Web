---
import Base from "../layouts/Base.astro";
import SiteHeader from "@delead/ui/astro/SiteHeader.astro";
import SiteFooter from "@delead/ui/astro/SiteFooter.astro";
import LeadForm from "@delead/ui/astro/LeadForm.astro";
import Stat from "@delead/ui/astro/Stat.astro";
import { getContent } from "../lib/content";

const { testimonials, track, stats } = await getContent();

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Programmes", href: "#programmes" },
  { label: "Approach", href: "#approach" },
  { label: "Track record", href: "#track" },
  { label: "Contact", href: "#contact" },
];

const tracks = [
  ["Track 01", "Leadership Development", "Grow leaders at every level — theory paired with practice, on the floor.", ["Communication", "Emotional intelligence", "Strategic thinking", "Conflict resolution"]],
  ["Track 02", "Team Building", "Rebuild how a team communicates, trusts and solves problems, through experience.", ["Collaboration", "Problem-solving", "Trust", "Adaptability"]],
  ["Track 03", "Strategic Thinking & Execution", "Move the team from firefighting to decisions aligned with where the business is going.", ["Decision-making", "Alignment to goals", "Innovation"]],
  ["Track 04", "Outbound Training", "Adventure-based challenges that show how a team really works together.", ["Flight Game", "Rope Passing", "Rope Escape", "Tower Building"]],
];
const steps = [
  ["01", "Experiential by default", "People learn by doing, under real pressure. Every session turns on an activity, not a slide."],
  ["02", "Tailored, not templated", "Assembled from your team's actual challenges and the room it happens in."],
  ["03", "Boardroom to open field", "Strategy drills and rope courses inside one engagement."],
  ["04", "The whole team", "Leadership included — that's where the shift actually sticks."],
];
---
<Base
  title="Corporate Training — De' Lead International"
  description="Leadership development, team building and outbound training for organisations across India and the UAE. Delivered for DP World, Kayzan Group, RAG Business Hub and Al Ahalia Group."
>
  <SiteHeader
    current="corporate"
    logoLight="/assets/logo/logo-delead-white.png"
    logoDark="/assets/logo/logo-delead-dark.png"
    links={navLinks}
    ctaLabel="Book a session"
    ctaHref="#contact"
  />

  <section id="top" class="relative flex min-h-[86svh] flex-col justify-center overflow-hidden bg-[linear-gradient(155deg,#750649,#2e0112)] px-6 pb-16 pt-32 text-white">
    <div class="mx-auto w-full max-w-[1240px]">
      <p class="mb-5 text-xs font-bold uppercase tracking-[0.18em] text-white/70">Corporate Training · India &amp; UAE</p>
      <h1 class="max-w-[15ch] font-[var(--font-display)] text-[clamp(2.8rem,7vw,5.4rem)] font-semibold leading-[1.04]">
        Leadership that outlasts the offsite.
      </h1>
      <p class="mt-6 max-w-[52ch] text-lg text-white/80">
        We don't run workshops. We build the situations your team has to think their way
        through — then carry the lesson back to the desk. Directed and facilitated by
        Arjun C P and Sabarinath K.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#contact" class="ui-btn ui-btn--cream">Book a session</a>
        <a href="#programmes" class="ui-btn ui-btn--ghost">See the programmes</a>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-ink)]">
    <div class="mx-auto grid max-w-[1240px] grid-cols-2 sm:grid-cols-4">
      {stats.map((s) => (
        <div class="border-l border-white/10 px-4 py-7 first:border-l-0 sm:px-8">
          <Stat value={s.value} suffix={s.suffix} label={s.label} onDark />
        </div>
      ))}
    </div>
  </section>

  <section id="about" class="bg-white px-6 py-24">
    <div class="mx-auto max-w-[1240px]" data-reveal>
      <span class="ui-eyebrow">About</span>
      <h2 class="mt-3 max-w-[20ch] font-[var(--font-display)] text-[clamp(2rem,3.6vw,3rem)] font-semibold">
        An experiential-first training practice
      </h2>
      <p class="mt-4 max-w-[70ch] text-[var(--color-ink-soft)]">
        Built for teams that have outgrown the classroom. Every session runs on an activity, not
        a slide: a real problem, real pressure, and a debrief that translates straight back to how
        the team works day to day — from a boardroom in Business Bay to a farmhouse in Al Rahba.
      </p>
    </div>
  </section>

  <section id="programmes" class="bg-[var(--color-cream-2)] px-6 py-24">
    <div class="mx-auto max-w-[1240px]">
      <div class="max-w-[640px]" data-reveal>
        <span class="ui-eyebrow">What we run</span>
        <h2 class="mt-3 font-[var(--font-display)] text-[clamp(1.9rem,3.4vw,2.8rem)] font-semibold">
          Four tracks, combined into one engagement
        </h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2" data-reveal="stagger">
        {tracks.map(([cat, h, p, chips]) => (
          <article class="rounded-2xl border border-[var(--color-line)] bg-white p-8">
            <span class="text-xs font-bold uppercase tracking-wide text-[var(--color-magenta)]">{cat}</span>
            <h3 class="mt-1 font-[var(--font-display)] text-xl font-semibold">{h}</h3>
            <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{p}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {(chips as string[]).map((c) => (
                <li class="rounded-full bg-[var(--color-cream-2)] px-3 py-1 text-xs">{c}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="approach" class="bg-[var(--color-ink)] px-6 py-24 text-white">
    <div class="mx-auto max-w-[1240px]">
      <h2 class="max-w-[640px] font-[var(--font-display)] text-[clamp(1.9rem,3.4vw,2.8rem)] font-semibold" data-reveal>
        The method behind every batch
      </h2>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2" data-reveal="stagger">
        {steps.map(([n, h, p]) => (
          <li class="rounded-2xl bg-white/5 p-7">
            <span class="font-[var(--font-display)] text-2xl font-bold text-[var(--color-magenta-soft)]">{n}</span>
            <h3 class="mt-2 font-[var(--font-display)] text-lg font-semibold">{h}</h3>
            <p class="mt-2 text-sm text-white/70">{p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {track.length > 0 && (
    <section id="track" class="bg-white px-6 py-24">
      <div class="mx-auto max-w-[1240px]">
        <div class="max-w-[640px]" data-reveal>
          <span class="ui-eyebrow">Proof</span>
          <h2 class="mt-3 font-[var(--font-display)] text-[clamp(1.9rem,3.4vw,2.8rem)] font-semibold">Engagements, dated and named</h2>
        </div>
        <div class="mt-10 flex gap-4 overflow-x-auto pb-4" data-reveal>
          {track.map((t) => (
            <article class="w-72 shrink-0 rounded-2xl border border-[var(--color-line)] bg-[var(--color-cream)] p-6">
              <span class="text-xs font-bold uppercase tracking-wide text-[var(--color-magenta)]">{t.whenLabel}</span>
              <h3 class="mt-1 font-[var(--font-display)] text-lg font-semibold">{t.client}</h3>
              <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{t.blurb}</p>
              {t.badge && <span class="mt-3 inline-block rounded-full bg-[var(--color-magenta)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-magenta)]">{t.badge}</span>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="bg-[var(--color-cream-2)] px-6 py-24">
      <div class="mx-auto max-w-[1240px]">
        <h2 class="font-[var(--font-display)] text-[clamp(1.9rem,3.4vw,2.8rem)] font-semibold" data-reveal>In their words</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3" data-reveal="stagger">
          {testimonials.map((t) => (
            <figure class="rounded-2xl bg-white p-8">
              <blockquote class="text-[var(--color-ink-soft)]">&ldquo;{t.quote}&rdquo;</blockquote>
              <figcaption class="mt-4 text-sm font-semibold">{t.authorName}<span class="font-normal text-[var(--color-ink-soft)]"> · {t.authorRole}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="contact" class="bg-white px-6 py-24">
    <div class="mx-auto grid max-w-[1240px] gap-12 lg:grid-cols-2">
      <div data-reveal>
        <span class="ui-eyebrow">Get in touch</span>
        <h2 class="mt-3 font-[var(--font-display)] text-[clamp(1.9rem,3.4vw,2.8rem)] font-semibold">Plan your team's next session</h2>
        <p class="mt-4 max-w-[46ch] text-[var(--color-ink-soft)]">
          Tell us the team, the challenge and the room. One of the directors replies within a
          couple of working days.
        </p>
      </div>
      <div data-reveal>
        <LeadForm source="corporate" interests={["Leadership Development", "Team Building", "Strategic Thinking & Execution", "Outbound Training", "Not sure yet — let's talk"]} />
      </div>
    </div>
  </section>

  <SiteFooter brandName="De' Lead International" blurb="The corporate training practice of De' Lead International — leadership, team building and outbound programmes across India and the UAE." />
</Base>
