const LEAD_ENDPOINT = import.meta.env.PUBLIC_LEAD_ENDPOINT || "https://admin.deleadint.com/api/lead";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Corporate Training: De' Lead International</title>
<meta name="description" content="Leadership development, team building and outbound training for organisations across India and the UAE. Delivered for DP World, Kayzan Group, RAG Business Hub and Al Ahalia Group.">
<link rel="icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<!-- ============ NAV ============ -->
<header class="nav" id="top">
  <div class="nav-pill">
    <a href="#top" class="brand">
      <img class="brand-white" src="/assets/logo/logo-delead-white.png" alt="De' Lead International">
      <img class="brand-dark" src="/assets/logo/logo-delead-dark.png" alt="De' Lead International">
      <span class="brand-sub">Corporate Training</span>
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="#about">About</a>
      <a href="#programmes">Programmes</a>
      <a href="#approach">Approach</a>
      <a href="#track-record">Track record</a>
      <a href="#team">Team</a>
      <a href="#contact">Contact</a>
      <a class="nav-home nav-home-inline" href="https://deleadint.com" target="_blank" rel="noopener">De'&nbsp;Lead&nbsp;International&nbsp;&nearr;</a>
    </nav>
    <div class="nav-cta">
      <a class="nav-home nav-home-desk" href="https://deleadint.com" target="_blank" rel="noopener">De'&nbsp;Lead&nbsp;&nearr;</a>
      <a class="btn btn-primary btn-dot" href="#contact">Book a session</a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero">
  <img class="hero-bg" src="/assets/photos/facilitator-mic.webp" alt="A De' Lead facilitator leading a corporate training session">
  <div class="hero-inner">
    <span class="eyebrow on-dark"><i class="mk"></i>Corporate Training &middot; India &amp; UAE</span>
    <h1>Leadership that outlasts the offsite.</h1>
    <div class="hero-actions">
      <a href="#contact" class="btn btn-cream btn-dot">Book a session</a>
      <a href="#programmes" class="btn btn-ghost on-dark">See the programmes</a>
    </div>
    <ul class="hero-check">
      <li>Leadership development</li>
      <li>Team building</li>
      <li>Outbound training</li>
    </ul>
  </div>
</section>

<!-- ============ FACT MARQUEE ============ -->
<section class="facts">
  <div class="facts-row">
    <div class="facts-track">
      <article class="fact"><span class="fact-k">Since 2023</span><p><b>7+</b> corporate engagements delivered</p></article>
      <article class="fact"><span class="fact-k">DP World</span><p><b>100</b> staff in a single confidence &amp; team-building cohort</p></article>
      <article class="fact"><span class="fact-k">Kayzan Group</span><p><b>35</b> senior staff on a two-day outbound in Abu Dhabi</p></article>
      <article class="fact"><span class="fact-k">Al Ahalia Group</span><p><b>50+</b> decision-makers across five departments</p></article>
      <article class="fact"><span class="fact-k">Reach</span><p><b>5</b> client organisations, India &amp; the UAE</p></article>
      <article class="fact"><span class="fact-k">Formats</span><p>Half-day, one-day, or two-day residential</p></article>
      <article class="fact" aria-hidden="true"><span class="fact-k">Since 2023</span><p><b>7+</b> corporate engagements delivered</p></article>
      <article class="fact" aria-hidden="true"><span class="fact-k">DP World</span><p><b>100</b> staff in a single confidence &amp; team-building cohort</p></article>
      <article class="fact" aria-hidden="true"><span class="fact-k">Kayzan Group</span><p><b>35</b> senior staff on a two-day outbound in Abu Dhabi</p></article>
      <article class="fact" aria-hidden="true"><span class="fact-k">Al Ahalia Group</span><p><b>50+</b> decision-makers across five departments</p></article>
      <article class="fact" aria-hidden="true"><span class="fact-k">Reach</span><p><b>5</b> client organisations, India &amp; the UAE</p></article>
      <article class="fact" aria-hidden="true"><span class="fact-k">Formats</span><p>Half-day, one-day, or two-day residential</p></article>
    </div>
  </div>
</section>

<!-- ============ STATEMENT ============ -->
<section class="statement">
  <div class="wrap reveal">
    <h2>We don&rsquo;t run workshops. We build the situations your team has to think their way through, then carry the lesson back to the desk.</h2>
    <p>Directed by <b>Arjun&nbsp;C&nbsp;P</b> and <b>Sabarinath&nbsp;K</b>, who facilitate the sessions themselves. Every engagement is assembled from your team&rsquo;s real challenges, not an off-the-shelf deck, from a boardroom in Business Bay to a farmhouse in Al Rahba.</p>
  </div>
</section>

<!-- ============ OVERVIEW / ABOUT ============ -->
<section class="section overview" id="about">
  <div class="wrap ov-grid reveal">
    <div class="ov-intro">
      <span class="eyebrow"><i class="mk"></i>About</span>
      <h2>An experiential-first training practice</h2>
      <p>Our corporate practice was built for teams that have outgrown the classroom. Every session runs on an activity, not a slide: a real problem, real pressure, and a debrief that translates straight back to how the team works day to day. Programmes are delivered on the ground in India and the UAE, across sectors from ports and logistics to healthcare and business services.</p>
    </div>
    <div class="ov-cards">
      <article class="ov-card">
        <span class="eyebrow"><i class="mk"></i>Mission</span>
        <p>Empower organisations and individuals with transformative learning experiences: a culture of continuous growth and excellence, guided by innovation, integrity and inclusivity.</p>
      </article>
      <article class="ov-card">
        <span class="eyebrow"><i class="mk"></i>Vision</span>
        <p>Be the catalyst for transformative growth: a premier provider of innovative, tailored corporate training that helps businesses and professionals navigate an ever-changing world.</p>
      </article>
    </div>
  </div>
</section>

<!-- ============ PROGRAMMES ============ -->
<section class="section programmes" id="programmes">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><i class="mk"></i>What we run</span>
      <h2>Four tracks, combined into one engagement</h2>
      <p>Most engagements draw on two or more, scaled to the team and the room.</p>
    </div>

    <div class="prog-grid reveal">
      <article class="pcard pc-1">
        <div class="pcard-top"><span class="pcard-cat">Track 01</span><h3>Leadership Development</h3></div>
        <div class="pcard-bot">
          <p>Grow leaders at every level: theory paired with practice, on the floor.</p>
          <ul class="chips">
            <li>Communication</li><li>Emotional intelligence</li><li>Strategic thinking</li><li>Conflict resolution</li><li>Decision-making</li>
          </ul>
        </div>
      </article>

      <article class="pcard pc-2">
        <div class="pcard-top"><span class="pcard-cat">Track 02</span><h3>Team Building</h3></div>
        <div class="pcard-bot">
          <p>Rebuild how a team communicates, trusts and solves problems, through experience.</p>
          <ul class="chips">
            <li>Collaboration</li><li>Problem-solving</li><li>Trust</li><li>Productivity</li><li>Adaptability</li>
          </ul>
        </div>
      </article>

      <article class="pcard pc-3">
        <div class="pcard-top"><span class="pcard-cat">Track 03</span><h3>Strategic Thinking &amp; Execution</h3></div>
        <div class="pcard-bot">
          <p>Move the team from firefighting to decisions aligned with where the business is going.</p>
          <ul class="chips">
            <li>Decision-making</li><li>Alignment to goals</li><li>Adaptability</li><li>Innovation</li>
          </ul>
        </div>
      </article>

      <article class="pcard pc-4">
        <div class="pcard-top"><span class="pcard-cat">Track 04</span><h3>Outbound Training</h3></div>
        <div class="pcard-bot">
          <p>Take the team out of the office into adventure-based challenges that show how they really work together.</p>
          <ul class="chips">
            <li>Team cohesion</li><li>Leadership</li><li>Trust</li><li>Culture shift</li>
          </ul>
          <p class="pcard-sub">Signature activities: Flight Game &middot; Rope Passing &middot; Rope Escape &middot; Tower Building</p>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ============ BIG NUMBERS ============ -->
<section class="section nums">
  <div class="wrap">
    <div class="nums-grid reveal">
      <div class="num"><b data-count="7" data-suffix="+">7+</b><span>Corporate engagements since 2023</span></div>
      <div class="num"><b data-count="100" data-suffix="">100</b><span>Staff in a single DP World cohort</span></div>
      <div class="num"><b data-count="50" data-suffix="+">50+</b><span>Decision-makers trained at Al Ahalia Group</span></div>
      <div class="num"><b>India &amp; UAE</b><span>Sessions run on the ground in both</span></div>
    </div>
  </div>
</section>

<!-- ============ APPROACH ============ -->
<section class="section approach" id="approach">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow on-dark"><i class="mk"></i>How every programme runs</span>
      <h2>The method behind every batch</h2>
    </div>
    <ol class="steps reveal">
      <li><span class="step-n">01</span><div><h4>Experiential by default</h4><p>People learn by doing, under real pressure. Every session turns on an activity, not a slide.</p></div></li>
      <li><span class="step-n">02</span><div><h4>Tailored, not templated</h4><p>Assembled from your team&rsquo;s actual challenges and the room it happens in.</p></div></li>
      <li><span class="step-n">03</span><div><h4>Boardroom to open field</h4><p>Strategy drills and rope courses inside one engagement.</p></div></li>
      <li><span class="step-n">04</span><div><h4>The whole team</h4><p>Leadership included. That&rsquo;s where the shift actually sticks.</p></div></li>
    </ol>
  </div>
</section>

<!-- ============ TRACK RECORD ============ -->
<section class="section track" id="track-record">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><i class="mk"></i>Proof</span>
      <h2>Engagements, dated and named</h2>
      <p>Corporate programmes delivered since 2023.</p>
    </div>
  </div>
  <div class="track-scroll">
    <div class="track-row">
      <article class="tcard"><span class="tcard-when">Feb 2023</span><h4>RAG Business Hub</h4><p>Full-staff leadership training: decision-making, communication, a culture of innovation.</p><span class="tcard-badge">Whole company</span></article>
      <article class="tcard"><span class="tcard-when">Dec 2023</span><h4>DP World</h4><p>Confidence and team building for a cohort of 100 staff, personalised coaching and exercises.</p><span class="tcard-badge">100 staff</span></article>
      <article class="tcard"><span class="tcard-when">Feb 2024</span><h4>RAG Business Hub</h4><p>Team building at the Business Bay head office for the entire team, CEO and co-founder included.</p><span class="tcard-badge">CEO included</span></article>
      <article class="tcard"><span class="tcard-when">Mar 2024</span><h4>Kayzan Group</h4><p>Two-day immersive outbound for 35 senior members at a farmhouse in Al Rahba, Abu Dhabi.</p><span class="tcard-badge">2 days &middot; 35 people</span></article>
      <article class="tcard"><span class="tcard-when">May 2024</span><h4>Kayzan Group</h4><p>Emotional Selling &amp; Leadership Accelerator for the sales team, Al Bustan Centre, Dubai.</p><span class="tcard-badge">Sales team</span></article>
      <article class="tcard"><span class="tcard-when">Sep 2024</span><h4>Al Ahalia Group</h4><p>Next Level Leadership for 50+ decision-makers across medical, operations, nursing, marketing &amp; admin.</p><span class="tcard-badge">50+ leaders</span></article>
      <article class="tcard"><span class="tcard-when">Feb 2025</span><h4>DP World Digital</h4><p>Activity-based team building for the Enterprise Systems team, running 12:30pm to 10pm, with a BBQ.</p><span class="tcard-badge">Full day</span></article>
      <article class="tcard" aria-hidden="true"><span class="tcard-when">Feb 2023</span><h4>RAG Business Hub</h4><p>Full-staff leadership training: decision-making, communication, a culture of innovation.</p><span class="tcard-badge">Whole company</span></article>
      <article class="tcard" aria-hidden="true"><span class="tcard-when">Dec 2023</span><h4>DP World</h4><p>Confidence and team building for a cohort of 100 staff, personalised coaching and exercises.</p><span class="tcard-badge">100 staff</span></article>
      <article class="tcard" aria-hidden="true"><span class="tcard-when">Feb 2024</span><h4>RAG Business Hub</h4><p>Team building at the Business Bay head office for the entire team, CEO and co-founder included.</p><span class="tcard-badge">CEO included</span></article>
      <article class="tcard" aria-hidden="true"><span class="tcard-when">Mar 2024</span><h4>Kayzan Group</h4><p>Two-day immersive outbound for 35 senior members at a farmhouse in Al Rahba, Abu Dhabi.</p><span class="tcard-badge">2 days &middot; 35 people</span></article>
      <article class="tcard" aria-hidden="true"><span class="tcard-when">May 2024</span><h4>Kayzan Group</h4><p>Emotional Selling &amp; Leadership Accelerator for the sales team, Al Bustan Centre, Dubai.</p><span class="tcard-badge">Sales team</span></article>
      <article class="tcard" aria-hidden="true"><span class="tcard-when">Sep 2024</span><h4>Al Ahalia Group</h4><p>Next Level Leadership for 50+ decision-makers across medical, operations, nursing, marketing &amp; admin.</p><span class="tcard-badge">50+ leaders</span></article>
      <article class="tcard" aria-hidden="true"><span class="tcard-when">Feb 2025</span><h4>DP World Digital</h4><p>Activity-based team building for the Enterprise Systems team, running 12:30pm to 10pm, with a BBQ.</p><span class="tcard-badge">Full day</span></article>
    </div>
  </div>
  <div class="wrap"><p class="track-note">Dates and details per De&rsquo; Lead International&rsquo;s programme records.</p></div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section testi" id="testimonials">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><i class="mk"></i>What clients say</span>
      <h2>In their words</h2>
      <p>Short quotes from the people who booked the programme.</p>
    </div>
    <div class="testi-grid reveal">
      <figure class="quote">
        <span class="quote-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>The two days out of the office did more for how the team communicates than anything we had tried in-house. People came back talking to each other differently.</blockquote>
        <figcaption><b>[Client name]</b><span>[Role], [Company]</span></figcaption>
      </figure>
      <figure class="quote">
        <span class="quote-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>It was built around our actual challenges, not a generic deck. The facilitators ran the room themselves and kept every session hands-on.</blockquote>
        <figcaption><b>[Client name]</b><span>[Role], [Company]</span></figcaption>
      </figure>
      <figure class="quote">
        <span class="quote-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>Our leadership team took part alongside everyone else. That is what made the change stick once we were back at our desks.</blockquote>
        <figcaption><b>[Client name]</b><span>[Role], [Company]</span></figcaption>
      </figure>
    </div>
    <p class="testi-note">Placeholder quotes. Send the approved wording, names and roles and we will drop them in.</p>
  </div>
</section>

<!-- ============ TEAM ============ -->
<section class="team" id="team">
  <img class="team-bg" src="/assets/photos/client-team.webp" alt="A client team at the close of a De' Lead session">
  <div class="team-inner">
    <div class="team-head reveal">
      <span class="eyebrow on-dark"><i class="mk"></i>Who runs it</span>
      <h2>The directors run the room themselves</h2>
      <p>Both directors facilitate sessions in person, backed by specialist facilitators including an emotional-selling coach for sales teams.</p>
    </div>
    <div class="team-grid reveal">
      <figure class="member">
        <div class="member-photo"><img src="/assets/people/arjun-cp.webp" alt="Arjun C P"></div>
        <figcaption><b>Arjun C P</b><span>CTO &amp; Director</span><p>Leads strategy and outbound sessions.</p></figcaption>
      </figure>
      <figure class="member">
        <div class="member-photo"><img src="/assets/people/sabarinath-k.webp" alt="Sabarinath K"></div>
        <figcaption><b>Sabarinath K</b><span>CMO &amp; Director</span><p>Leads leadership and team-building sessions.</p></figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ============ GALLERY ============ -->
<section class="section gallery" id="gallery">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><i class="mk"></i>From the sessions</span>
      <h2>What a programme looks like</h2>
    </div>
    <div class="gallery-grid reveal">
      <figure class="g-a"><img src="/assets/photos/outbound-horse.webp" alt="Participant horse riding during an outbound session in Abu Dhabi" loading="lazy"><figcaption>Outbound, Al Rahba</figcaption></figure>
      <figure class="g-b"><img src="/assets/photos/facilitator-mic.webp" alt="A facilitator leading a corporate session" loading="lazy"><figcaption>On the floor</figcaption></figure>
      <figure class="g-c"><img src="/assets/photos/trophy-win.webp" alt="A team celebrating a challenge win" loading="lazy"><figcaption>Team challenge</figcaption></figure>
      <figure class="g-d"><img src="/assets/photos/support-activity.webp" alt="A group trust-and-support activity" loading="lazy"><figcaption>Trust exercise</figcaption></figure>
      <figure class="g-e"><img src="/assets/photos/sales-session.webp" alt="A training session in a Dubai conference hall" loading="lazy"><figcaption>Sales team, Dubai</figcaption></figure>
    </div>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="cta">
  <div class="wrap reveal">
    <span class="eyebrow on-dark"><i class="mk"></i>Get started</span>
    <h2>Plan your team&rsquo;s next session</h2>
    <p>Tell us the team, the challenge and the room. We&rsquo;ll build the programme around it.</p>
    <div class="cta-actions">
      <a href="#contact" class="btn btn-cream btn-dot">Book a session</a>
      <a href="https://wa.me/918075566081?text=Hi%20De'%20Lead%20-%20we'd%20like%20to%20talk%20about%20corporate%20training." target="_blank" rel="noopener" class="btn btn-ghost on-dark">WhatsApp us</a>
    </div>
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section class="section contact" id="contact">
  <div class="wrap contact-wrap">
    <div class="contact-head reveal">
      <span class="eyebrow"><i class="mk"></i>Get in touch</span>
      <h2>Start a conversation</h2>
      <p>One of the directors replies within a couple of working days.</p>
      <ul class="contact-lines">
        <li><a href="mailto:info@deleadint.com">info@deleadint.com</a></li>
        <li><a href="tel:+918075566081">+91 807 556 6081</a>, India</li>
        <li><a href="tel:+971506814538">+971 50 681 4538</a>, UAE</li>
      </ul>
    </div>
    <form data-lead-source="corporate" class="form reveal" id="enquiryForm" novalidate>
      <div class="f-row">
        <div class="f-field"><label for="f-name">Name</label><input type="text" id="f-name" name="name" required></div>
        <div class="f-field"><label for="f-email">Work email</label><input type="email" id="f-email" name="email" required></div>
      </div>
      <div class="f-row">
        <div class="f-field"><label for="f-company">Company</label><input type="text" id="f-company" name="company"></div>
        <div class="f-field"><label for="f-size">Team size</label>
          <select id="f-size" name="team_size"><option>Under 20</option><option>20&ndash;50</option><option>50&ndash;100</option><option>100+</option></select>
        </div>
      </div>
      <div class="f-field f-full"><label for="f-interest">What you&rsquo;re looking for</label>
        <select id="f-interest" name="interest">
          <option>Leadership Development</option><option>Team Building</option>
          <option>Strategic Thinking &amp; Execution</option><option>Outbound Training</option>
          <option>Not sure yet, let&rsquo;s talk</option>
        </select>
      </div>
      <div class="f-field f-full"><label for="f-message">Message</label><textarea id="f-message" name="message" rows="4" required></textarea></div>
      <button type="submit" class="btn btn-primary">Send message</button>
      <p class="form-success" id="formSuccess" hidden>Thanks, your message is in. We&rsquo;ll be in touch within a couple of working days.</p>
    </form>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/assets/logo/logo-delead-white.png" alt="De' Lead International">
        <p>The corporate training practice of De&rsquo; Lead International. Leadership, team building and outbound programmes across India and the UAE.</p>
        <span class="footer-tag">Learn, Develop &amp; Lead</span>
