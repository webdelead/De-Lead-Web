# Copy to .env and fill in. The real .env is gitignored.

SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-exposed Supabase config — REQUIRED by the dashboard's client-side auth
# (lib/supabase/client.ts reads only these). Same values as SUPABASE_URL /
# SUPABASE_ANON_KEY above; middleware/server fall back to the non-public names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

DATABASE_URL=          # transaction pooler, 6543 — dashboard + write APIs (delead_web_app role once split)
DATABASE_URL_RO=       # transaction pooler, 6543 — marketing sites, SELECT-only (delead_web_ro role). Falls back to DATABASE_URL if unset.
DIRECT_URL=            # session pooler, port 5432 (migrations / seed / CI / roles)

# Only needed when running `pnpm --filter @delead/db roles` to provision the split.
DELEAD_WEB_RO_PASSWORD=
DELEAD_WEB_APP_PASSWORD=

AUTH_SECRET=           # openssl rand -base64 33
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Bearer token for the Vercel cron keep-alive (/api/cron/ping). Optional for now
# (route is soft-guarded); will be made mandatory in a later pass. openssl rand -base64 33
CRON_SECRET=

# Cloudflare Turnstile (bot check on the public lead + booking forms). When
# TURNSTILE_SECRET_KEY is unset the server-side check is skipped (no-op), so the
# forms keep working until you provision keys. Site key is browser-exposed.
# Set TURNSTILE_ENFORCE=true only once the site forms actually send a token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE=

# Storage. `supabase` today; flip to `r2` after `pnpm --filter @delead/db migrate:storage`
# copies the objects. The R2 adapter (aws4fetch, S3 API) is implemented — just fill these in.
STORAGE_PROVIDER=supabase   # supabase | r2
R2_ACCOUNT_ID=              # Cloudflare account id (endpoint = https://<id>.r2.cloudflarestorage.com)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=        # public custom domain / r2.dev URL the sites link images from

APPS_SCRIPT_URL_DELEADINT=
APPS_SCRIPT_URL_WALK2LEAD=
APPS_SCRIPT_URL_MAKERCHAMPS=
APPS_SCRIPT_URL_CORPORATE=
APPS_SCRIPT_URL_DLI_EDUCATION=
APPS_SCRIPT_URL_TINKERCHAMPS=

# Shared secret for on-demand ISR: dashboard "Publish" POSTs
# <SITE_URL_*>/api/revalidate with this. Same value on every site + dashboard.
REVALIDATE_SECRET=

PUBLIC_LEAD_ENDPOINT=https://admin.deleadint.com/api/lead
SITE_URL_DELEADINT=https://deleadint.com
SITE_URL_WALK2LEAD=https://w2l.deleadint.com
SITE_URL_MAKERCHAMPS=https://mc.deleadint.com
SITE_URL_CORPORATE=https://corporate.deleadint.com
SITE_URL_DLI_EDUCATION=https://edu.deleadint.com
SITE_URL_TINKERCHAMPS=https://tc.deleadint.com
SITE_URL_DASHBOARD=https://admin.deleadint.com
