{
  "name": "@delead/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "schema": "tsx scripts/dump-schema.ts",
    "migrate": "tsx scripts/migrate.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts && tsx scripts/seed-content.ts",
    "seed:auth": "tsx scripts/seed.ts",
    "seed:content": "tsx scripts/seed-content.ts",
    "ping": "tsx scripts/ping.ts",
    "roles": "tsx scripts/apply-roles.ts",
    "outbox:flush": "tsx scripts/outbox-flush.ts",
    "blog:json": "tsx scripts/migrate-blog-json.ts",
    "import:sanity": "tsx scripts/import-sanity.ts",
    "migrate:storage": "tsx scripts/migrate-storage.ts",
    "typecheck": "tsc --noEmit",
    "populate": "tsx scripts/populate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "@tiptap/html": "^3.31.2",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "catalog:",
    "marked": "^18.0.11",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@delead/config": "workspace:*",
    "@delead/brand": "workspace:*",
    "@delead/shared": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
