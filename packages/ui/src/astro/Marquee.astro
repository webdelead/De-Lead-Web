---
/* Masked, auto-scrolling strip. The track animates by -50%, so the default
   slot must contain the content TWICE (second copy aria-hidden) for a
   seamless loop. Keeps zero JS. Pauses on hover; static under reduced-motion. */
interface Props { gap?: number; duration?: number; class?: string }
const { gap = 48, duration = 34, class: cls = "" } = Astro.props;
---
<div class:list={["ui-marquee", cls]} style={`--ui-marquee-gap:${gap}px;--ui-marquee-dur:${duration}s`}>
  <div class="ui-marquee__track">
    <slot />
  </div>
</div>
