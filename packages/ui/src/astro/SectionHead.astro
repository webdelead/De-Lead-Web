---
import Eyebrow from "./Eyebrow.astro";
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  center?: boolean;
  onDark?: boolean;
  class?: string;
}
const { eyebrow, title, lede, center = false, onDark = false, class: cls = "" } = Astro.props;
---
<div
  class:list={["ui-section-head", cls]}
  data-reveal
  style={`max-width:640px;${center ? "margin-inline:auto;text-align:center;" : ""}`}
>
  {eyebrow && <Eyebrow onDark={onDark}>{eyebrow}</Eyebrow>}
  <h2
    style={`font-size:clamp(2.1rem,3.6vw,3.1rem);margin:.6rem 0 .5rem;${onDark ? "color:#fff;" : ""}`}
    set:html={title}
  />
  {lede && (
    <p style={`font-size:1.05rem;color:${onDark ? "rgba(255,255,255,.78)" : "var(--color-ink-soft)"};`}>
      {lede}
    </p>
  )}
</div>
