---
/* Shared enquiry form. Posts JSON to PUBLIC_LEAD_ENDPOINT (the dashboard's
   /api/lead). Zero framework — one inline module script. */
interface Props {
  source: string; // vertical key, e.g. "walk2lead"
  interests?: string[];
  submitLabel?: string;
  note?: string;
  class?: string;
}
const {
  source,
  interests = [],
  submitLabel = "Send message",
  note = "We'll get back to you within a couple of working days.",
  class: cls = "",
} = Astro.props;
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? "https://admin.deleadint.com/api/lead";
---
<form class:list={["lead-form", cls]} data-lead-form data-endpoint={endpoint} data-source={source} novalidate>
  <div class="lead-form__row">
    <label>
      <span>Name</span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
  </div>
  <div class="lead-form__row">
    <label>
      <span>Phone</span>
      <input type="tel" name="phone" autocomplete="tel" />
    </label>
    {interests.length > 0 && (
      <label>
        <span>I'm interested in</span>
        <select name="interest">
          {interests.map((i) => <option value={i}>{i}</option>)}
        </select>
      </label>
    )}
  </div>
  <label class="lead-form__full">
    <span>Message</span>
    <textarea name="message" rows="4" required></textarea>
  </label>
  <!-- honeypot -->
  <input type="text" name="company_website" tabindex="-1" autocomplete="off" class="lead-form__hp" aria-hidden="true" />
  <button type="submit" class="ui-btn ui-btn--primary">{submitLabel}</button>
  <p class="lead-form__note">{note}</p>
  <p class="lead-form__ok" hidden>Thanks — your message is in. We'll be in touch shortly.</p>
  <p class="lead-form__err" hidden>Something went wrong. Please email info@deleadint.com.</p>
</form>

<style>
  .lead-form { max-width: 640px; display: grid; gap: 16px; }
  .lead-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .lead-form label { display: flex; flex-direction: column; gap: 6px; }
  .lead-form label span { font-size: 0.8rem; font-weight: 600; color: var(--color-ink-soft); }
  .lead-form input, .lead-form select, .lead-form textarea {
    font: inherit; font-size: 0.95rem; color: var(--color-ink);
    background: var(--color-paper); border: 1px solid var(--color-line);
    border-radius: 12px; padding: 12px 14px; transition: border-color 0.18s;
  }
  .lead-form input:focus, .lead-form select:focus, .lead-form textarea:focus {
    outline: none; border-color: var(--accent);
  }
  .lead-form textarea { resize: vertical; min-height: 110px; }
  .lead-form__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .lead-form__note { font-size: 0.8rem; color: var(--color-ink-soft); }
  .lead-form__ok { color: #15803d; font-weight: 600; }
  .lead-form__err { color: #b91c1c; font-weight: 600; }
  .lead-form[data-busy] button { opacity: 0.6; pointer-events: none; }
  @media (max-width: 560px) { .lead-form__row { grid-template-columns: 1fr; } }
</style>

<script>
  function wire(form: HTMLFormElement) {
    const endpoint = form.dataset.endpoint!;
    const source = form.dataset.source!;
    const ok = form.querySelector<HTMLElement>(".lead-form__ok")!;
    const err = form.querySelector<HTMLElement>(".lead-form__err")!;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      ok.hidden = true;
      err.hidden = true;
      if ((form.elements.namedItem("company_website") as HTMLInputElement)?.value) return; // bot
      if (!form.reportValidity()) return;
      form.setAttribute("data-busy", "");
      const fd = new FormData(form);
      const payload = {
        source,
        name: String(fd.get("name") ?? ""),
        email: String(fd.get("email") ?? ""),
        phone: String(fd.get("phone") ?? ""),
        interest: String(fd.get("interest") ?? ""),
        message: String(fd.get("message") ?? ""),
        pagePath: location.pathname,
      };
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        ok.hidden = false;
      } catch {
        err.hidden = false;
      } finally {
        form.removeAttribute("data-busy");
      }
    });
  }
  document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach(wire);
</script>
