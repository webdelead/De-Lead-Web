---
import { VERTICAL_LIST, GOAL_FINDER, type VerticalSlug } from "@delead/brand/verticals";
interface Props { current?: VerticalSlug; variant?: "panel" | "list" }
const { current, variant = "panel" } = Astro.props;
const items = VERTICAL_LIST.filter((v) => v.slug !== current);
---
<div class:list={["eco-menu", `eco-menu--${variant}`]}>
  {items.map((v) => (
    <a class="eco-menu__item" href={v.host}>
      <span class="eco-menu__name">{v.name}</span>
      <span class="eco-menu__go" aria-hidden="true">→</span>
    </a>
  ))}
  <a class="eco-menu__item" href={GOAL_FINDER.url} target="_blank" rel="noopener">
    <span class="eco-menu__name">{GOAL_FINDER.name}</span>
    <span class="eco-menu__go" aria-hidden="true">↗</span>
  </a>
</div>

<style>
  .eco-menu { display: grid; gap: 2px; }
  .eco-menu--panel { grid-template-columns: 1fr 1fr; gap: 6px; }
  .eco-menu__item {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 14px; border-radius: 12px; color: var(--color-ink);
    font-weight: 600; font-size: 0.95rem; transition: background 0.18s;
  }
  .eco-menu__item:hover { background: var(--color-cream-2); }
  .eco-menu__go { opacity: 0.5; }
  @media (max-width: 720px) { .eco-menu--panel { grid-template-columns: 1fr; } }
</style>
