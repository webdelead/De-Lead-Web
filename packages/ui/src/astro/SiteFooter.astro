---
import { VERTICAL_LIST, GOAL_FINDER } from "@delead/brand/verticals";
import { CONTACT_EMAIL, PHONE_IN, PHONE_AE } from "../lib/index.ts";
interface Props {
  brandName?: string;
  blurb?: string;
  columns?: { title: string; links: { label: string; href: string; external?: boolean }[] }[];
}
const {
  brandName = "De' Lead International",
  blurb = "An education innovation ecosystem empowering students, institutions, professionals and organisations across India and the UAE.",
  columns = [],
} = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <strong>{brandName}</strong>
      <p>{blurb}</p>
      <span class="site-footer__tag">Learn, Develop &amp; Lead</span>
    </div>

    {columns.map((col) => (
      <div class="site-footer__col">
        <h4>{col.title}</h4>
        <ul>
          {col.links.map((l) => (
            <li>
              <a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="site-footer__col">
      <h4>Ecosystem</h4>
      <ul>
        {VERTICAL_LIST.map((v) => (
          <li><a href={v.host} target="_blank" rel="noopener">{v.name}</a></li>
        ))}
        <li><a href={GOAL_FINDER.url} target="_blank" rel="noopener">{GOAL_FINDER.name}</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h4>Contact</h4>
      <ul>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li><a href={`tel:${PHONE_IN}`}>+91 807 556 6081</a> · India</li>
        <li><a href={`tel:${PHONE_AE}`}>+971 50 681 4538</a> · UAE</li>
      </ul>
      <address>
        Ramanattukara, Kozhikode, Kerala, India<br />
        SPC FZC, Sharjah, UAE
      </address>
    </div>
  </div>

  <div class="site-footer__bottom">
    <span>&copy; {year} {brandName}. All rights reserved.</span>
    <span>www.deleadint.com</span>
  </div>
</footer>

<style>
  .site-footer { background: #150a10; color: #e9dbe2; padding: 72px 24px 28px; }
  .site-footer__grid {
    max-width: var(--container-site); margin-inline: auto;
    display: grid; grid-template-columns: 1.4fr repeat(auto-fit, minmax(150px, 1fr));
    gap: 42px; margin-bottom: 48px;
  }
  .site-footer__brand strong { font-family: var(--font-display); font-size: 1.1rem; color: #fff; display: block; margin-bottom: 12px; }
  .site-footer__brand p { color: #b79aa8; font-size: 0.9rem; max-width: 34ch; margin: 0 0 14px; }
  .site-footer__tag { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: #a9738f; }
  .site-footer__col h4 { font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase; color: #a9738f; margin: 0 0 14px; }
  .site-footer__col ul { list-style: none; margin: 0 0 14px; padding: 0; }
  .site-footer__col li { margin-bottom: 10px; }
  .site-footer__col a { color: #d9c6d0; font-size: 0.9rem; transition: color 0.18s; }
  .site-footer__col a:hover { color: #fff; }
  .site-footer__col address { font-style: normal; font-size: 0.85rem; color: #c8adba; line-height: 1.6; }
  .site-footer__bottom {
    max-width: var(--container-site); margin-inline: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 22px;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    font-size: 0.8rem; color: #9a7d8a;
  }
</style>
