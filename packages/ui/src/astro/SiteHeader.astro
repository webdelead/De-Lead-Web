---
import EcosystemMenu from "./EcosystemMenu.astro";
import type { VerticalSlug } from "@delead/brand/verticals";

interface NavLink { label: string; href: string }
interface Props {
  current: VerticalSlug;
  brandHref?: string;
  logoLight: string; // path served from the app's /public
  logoDark: string;
  links: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
  showEcosystem?: boolean;
}
const {
  current,
  brandHref = "#top",
  logoLight,
  logoDark,
  links,
  ctaLabel = "Enquire",
  ctaHref = "#contact",
  showEcosystem = true,
} = Astro.props;
---
<header class="sh" id="site-header" data-sh>
  <div class="sh__inner">
    <a class="sh__brand" href={brandHref} aria-label="Home">
      <img class="sh__logo sh__logo--light" src={logoLight} alt="" width="132" height="30" />
      <img class="sh__logo sh__logo--dark" src={logoDark} alt="" width="132" height="30" />
    </a>

    <nav class="sh__nav" data-sh-nav>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      {showEcosystem && (
        <div class="sh__drop" data-sh-drop>
          <button type="button" class="sh__drop-btn" aria-expanded="false">
            Ecosystem
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
          </button>
          <div class="sh__drop-panel">
            <EcosystemMenu current={current} />
          </div>
        </div>
      )}
      <a class="sh__nav-cta" href={ctaHref}>{ctaLabel}</a>
    </nav>

    <a class="ui-btn ui-btn--primary sh__cta" href={ctaHref}>{ctaLabel}</a>
    <button class="sh__toggle" data-sh-toggle aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .sh {
    position: fixed; inset: 0 0 auto; z-index: 100; padding: 20px 0;
    transition: background 0.3s, padding 0.3s, box-shadow 0.3s, transform 0.3s;
  }
  .sh[data-scrolled] {
    background: color-mix(in srgb, var(--color-cream) 88%, transparent);
    backdrop-filter: blur(10px); padding: 12px 0;
    box-shadow: 0 1px 0 rgba(28, 20, 23, 0.08);
  }
  .sh[data-hidden] { transform: translateY(-100%); }
  .sh__inner {
    max-width: var(--container-site); margin-inline: auto; padding-inline: 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
  }
  .sh__logo { height: 30px; width: auto; }
  .sh__logo--dark { display: none; }
  .sh[data-scrolled] .sh__logo--light { display: none; }
  .sh[data-scrolled] .sh__logo--dark { display: block; }
  .sh__nav { display: flex; align-items: center; gap: 4px; }
  .sh__nav > a {
    font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.85); padding: 9px 14px; border-radius: 999px; transition: color 0.18s, background 0.18s;
  }
  .sh__nav > a:hover { color: #fff; background: rgba(255, 255, 255, 0.12); }
  .sh[data-scrolled] .sh__nav > a { color: var(--color-ink-soft); }
  .sh[data-scrolled] .sh__nav > a:hover { color: var(--color-ink); background: rgba(28, 20, 23, 0.06); }
  .sh__nav-cta, .sh__cta { display: none; }

  .sh__drop { position: relative; }
  .sh__drop-btn {
    display: inline-flex; align-items: center; gap: 6px; font: inherit; cursor: pointer;
    background: none; border: 0; color: inherit;
    font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.85); padding: 9px 14px; border-radius: 999px;
  }
  .sh[data-scrolled] .sh__drop-btn { color: var(--color-ink-soft); }
  .sh__drop-panel {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(-6px);
    width: 460px; background: #fff; border-radius: 18px; box-shadow: var(--shadow-md);
    padding: 18px 14px; opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  .sh__drop[data-open] .sh__drop-panel {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0);
  }

  .sh__cta { display: inline-flex; }
  .sh__toggle { display: none; flex-direction: column; gap: 5px; padding: 6px; background: none; border: 0; cursor: pointer; }
  .sh__toggle span { width: 24px; height: 2px; background: #fff; border-radius: 2px; transition: transform 0.3s, opacity 0.3s, background 0.3s; }
  .sh[data-scrolled] .sh__toggle span { background: var(--color-ink); }

  @media (max-width: 900px) {
    .sh__cta { display: none; }
    .sh__toggle { display: flex; }
    .sh__nav {
      position: fixed; inset: 0 0 0 auto; width: min(320px, 84vw); background: var(--color-cream);
      flex-direction: column; align-items: flex-start; justify-content: flex-start;
      padding: 104px 28px 28px; gap: 4px; transform: translateX(100%); transition: transform 0.35s var(--ease-out-soft);
      box-shadow: -20px 0 60px -20px rgba(0, 0, 0, 0.3);
    }
    .sh__nav[data-open] { transform: translateX(0); }
    .sh__nav > a { color: var(--color-ink); font-size: 1.02rem; width: 100%; text-transform: none; letter-spacing: normal; }
    .sh__drop { width: 100%; }
    .sh__drop-btn { color: var(--color-ink); width: 100%; justify-content: space-between; font-size: 1.02rem; text-transform: none; letter-spacing: normal; }
    .sh__drop-panel {
      position: static; transform: none; width: 100%; box-shadow: none; background: transparent; padding: 0 0 0 8px;
      max-height: 0; overflow: hidden; opacity: 1; visibility: visible; transition: max-height 0.3s;
    }
    .sh__drop[data-open] .sh__drop-panel { max-height: 520px; }
    .sh__nav-cta {
      display: inline-flex; margin-top: 10px; background: var(--accent); color: var(--accent-ink);
      padding: 12px 22px; border-radius: 999px; font-size: 0.9rem; font-weight: 600;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-sh]");
  const nav = document.querySelector<HTMLElement>("[data-sh-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-sh-toggle]");
  const drop = document.querySelector<HTMLElement>("[data-sh-drop]");
  const dropBtn = drop?.querySelector<HTMLButtonElement>(".sh__drop-btn");

  if (header) {
    let lastY = scrollY;
    const onScroll = () => {
      const y = scrollY;
      header.toggleAttribute("data-scrolled", y > 32);
      if (y > lastY && y > 120) header.setAttribute("data-hidden", "");
      else header.removeAttribute("data-hidden");
      lastY = y;
    };
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  toggle?.addEventListener("click", () => {
    const open = nav?.toggleAttribute("data-open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
    document.body.style.overflow = open ? "hidden" : "";
  });
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      nav.removeAttribute("data-open");
      toggle?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }),
  );

  const setDrop = (v: boolean) => {
    drop?.toggleAttribute("data-open", v);
    dropBtn?.setAttribute("aria-expanded", v ? "true" : "false");
  };
  dropBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setDrop(!drop?.hasAttribute("data-open"));
  });
  if (matchMedia("(min-width: 901px)").matches) {
    drop?.addEventListener("mouseenter", () => setDrop(true));
    drop?.addEventListener("mouseleave", () => setDrop(false));
  }
  document.addEventListener("click", (e) => {
    if (drop && !drop.contains(e.target as Node)) setDrop(false);
  });
  addEventListener("keydown", (e) => e.key === "Escape" && setDrop(false));
</script>
